msgctxt "Languages::quissly_search.bi_used_up"
msgid "This month's requests are used up. Buy extra requests to keep answering."
msgstr "ამ თვის მოთხოვნები ამოიწურა. პასუხების გასაგრძელებლად შეიძინეთ დამატებითი მოთხოვნები."

msgctxt "Languages::quissly_search.bi_near"
msgid "Approaching your included requests for this period."
msgstr "ამ პერიოდის მოთხოვნების ლიმიტს უახლოვდებით."

msgctxt "Languages::quissly_search.bi_window"
msgid "Current window: [from] → [to]"
msgstr "მიმდინარე პერიოდი: [from] → [to]"

msgctxt "Languages::quissly_search.bi_extra_requests"
msgid "Extra requests"
msgstr "დამატებითი მოთხოვნები"

msgctxt "Languages::quissly_search.bi_block"
msgid "[product] · [count] extra requests"
msgstr "[product] · [count] დამატებითი მოთხოვნა"

msgctxt "Languages::quissly_search.bi_extra_month"
msgid "[product] extra this month"
msgstr "[product] დამატებით ამ თვეში"

msgctxt "Languages::quissly_search.bi_carry_hint"
msgid "Unused ones carry over"
msgstr "გამოუყენებელი გადადის"

msgctxt "Languages::quissly_search.bi_extra_text"
msgid "Extra requests are bought in blocks and charged to your card at once. They carry over to next month while your plan continues."
msgstr "დამატებითი მოთხოვნები ბლოკებად იყიდება და თანხა ბარათიდან მაშინვე ჩამოიჭრება. სანამ გეგმა მოქმედებს, ისინი შემდეგ თვეზე გადადის."

msgctxt "Languages::quissly_search.bi_buy_more"
msgid "Buy [count] more for [price]"
msgstr "კიდევ [count]-ის ყიდვა [price]-ად"

msgctxt "Languages::quissly_search.bi_invoices"
msgid "Invoices"
msgstr "ინვოისები"

msgctxt "Languages::quissly_search.bi_invoices_failed"
msgid "Invoices could not be loaded just now."
msgstr "ინვოისების ჩატვირთვა ახლა ვერ მოხერხდა."

msgctxt "Languages::quissly_search.bi_no_payments"
msgid "No payments yet."
msgstr "გადახდები ჯერ არ არის."

msgctxt "Languages::quissly_search.bi_invoice_for"
msgid "[date] · for [period]"
msgstr "[date] · პერიოდი [period]"

msgctxt "Languages::quissly_search.bi_pdf"
msgid "PDF"
msgstr "PDF"

msgctxt "Languages::quissly_search.bi_payment_method"
msgid "Payment method"
msgstr "გადახდის მეთოდი"

msgctxt "Languages::quissly_search.bi_paddle"
msgid "Payments are processed by Paddle, Quissly's merchant of record. Your card is never stored here."
msgstr "გადახდებს ამუშავებს Paddle, Quissly-ის ოფიციალური გამყიდველი. თქვენი ბარათი აქ არასდროს ინახება."

msgctxt "Languages::quissly_search.bi_card_on_file"
msgid "Card on file with Paddle"
msgstr "ბარათი შენახულია Paddle-ში"

msgctxt "Languages::quissly_search.bi_closed"
msgid "Paid plans open soon. The free search plan is available now."
msgstr "ფასიანი გეგმები მალე გაიხსნება. უფასო საძიებო გეგმა უკვე ხელმისაწვდომია."

msgctxt "Languages::quissly_search.bi_unreachable"
msgid "Quissly's billing could not be reached just now. Try again in a minute."
msgstr "Quissly-ის ბილინგთან დაკავშირება ახლა ვერ მოხერხდა. სცადეთ ერთ წუთში."

msgctxt "Languages::quissly_search.bi_working"
msgid "Working..."
msgstr "მუშავდება..."

msgctxt "Languages::quissly_search.bi_pay_waiting"
msgid "Finish the payment in the tab that opened. This page updates by itself once Quissly has it."
msgstr "დაასრულეთ გადახდა გახსნილ ჩანართში. Quissly-ის მიერ მიღებისთანავე ეს გვერდი თავად განახლდება."

msgctxt "Languages::quissly_search.bi_pay_timeout"
msgid "We have not seen the payment yet. Reload this page once you have paid."
msgstr "გადახდა ჯერ არ ჩანს. გადახდის შემდეგ გადატვირთეთ ეს გვერდი."

msgctxt "Languages::quissly_search.bi_close"
msgid "Close"
msgstr "დახურვა"

msgctxt "Languages::quissly_search.bi_title_change"
msgid "Change your plan"
msgstr "გეგმის შეცვლა"

msgctxt "Languages::quissly_search.bi_title_topup"
msgid "Buy extra requests"
msgstr "დამატებითი მოთხოვნების ყიდვა"

msgctxt "Languages::quissly_search.bi_title_cancel"
msgid "Cancel your plan?"
msgstr "გავაუქმოთ გეგმა?"

msgctxt "Languages::quissly_search.bi_title_pay"
msgid "Waiting for the payment"
msgstr "ველოდებით გადახდას"

msgctxt "Languages::quissly_search.bi_title_error"
msgid "Something went wrong"
msgstr "რაღაც შეცდომა მოხდა"

msgctxt "Languages::quissly_search.bi_cancel_plan"
msgid "Cancel plan"
msgstr "გეგმის გაუქმება"

msgctxt "Languages::quissly_search.bi_buy_now"
msgid "Buy now"
msgstr "ყიდვა"

msgctxt "Languages::quissly_search.bi_preview_upgrade"
msgid "[amount] is charged to your saved card now (the rest of this period), and the new plan starts at once."
msgstr "[amount] ახლავე ჩამოიჭრება შენახული ბარათიდან (ამ პერიოდის დარჩენილი ნაწილისთვის) და ახალი გეგმა მაშინვე დაიწყება."

msgctxt "Languages::quissly_search.bi_preview_downgrade"
msgid "Nothing is charged or refunded. Your plan changes on [date]."
msgstr "არაფერი ჩამოიჭრება და არც დაბრუნდება. გეგმა შეიცვლება [date]-ს."

msgctxt "Languages::quissly_search.bi_preview_trial"
msgid "Free during your trial. The plan changes now."
msgstr "საცდელ პერიოდში უფასოა. გეგმა ახლავე შეიცვლება."

msgctxt "Languages::quissly_search.bi_preview_other"
msgid "Your plan changes."
msgstr "თქვენი გეგმა შეიცვლება."

msgctxt "Languages::quissly_search.bi_preview_topup"
msgid "[count] extra requests for [amount], charged to your saved card now. They carry over to next month while the plan continues."
msgstr "[count] დამატებითი მოთხოვნა [amount]-ად, ახლავე ჩამოიჭრება შენახული ბარათიდან. სანამ გეგმა მოქმედებს, ისინი შემდეგ თვეზე გადადის."

msgctxt "Languages::quissly_search.bi_free_on"
msgid "The free plan is on."
msgstr "უფასო გეგმა ჩართულია."

msgctxt "Languages::quissly_search.bi_paid_on"
msgid "Payment received - your plan is on."
msgstr "გადახდა მიღებულია - გეგმა ჩართულია."

msgctxt "Languages::quissly_search.bi_done_scheduled"
msgid "Your plan changes on [date]."
msgstr "თქვენი გეგმა შეიცვლება [date]-ს."

msgctxt "Languages::quissly_search.bi_done_processing"
msgid "Payment is being confirmed; your new plan starts as soon as it lands."
msgstr "გადახდა დასტურდება; ახალი გეგმა დადასტურებისთანავე დაიწყება."

msgctxt "Languages::quissly_search.bi_done_changed"
msgid "Your plan has changed."
msgstr "თქვენი გეგმა შეიცვალა."

msgctxt "Languages::quissly_search.bi_topup_processing"
msgid "Payment is being confirmed; the extra requests are added as soon as it lands."
msgstr "გადახდა დასტურდება; დამატებითი მოთხოვნები დადასტურებისთანავე დაემატება."

msgctxt "Languages::quissly_search.bi_topup_added"
msgid "[count] extra requests added."
msgstr "დაემატა [count] დამატებითი მოთხოვნა."

msgctxt "Languages::quissly_search.bi_done_cancel"
msgid "Your plan is cancelled and ends at the end of the paid period."
msgstr "გეგმა გაუქმდა და გადახდილი პერიოდის ბოლოს დასრულდება."

msgctxt "Languages::quissly_search.bi_done_resume"
msgid "Your plan continues."
msgstr "თქვენი გეგმა გრძელდება."

msgctxt "Languages::quissly_search.bi_done_abort"
msgid "The scheduled change is undone."
msgstr "დაგეგმილი ცვლილება გაუქმდა."

msgctxt "Languages::quissly_search.bi_unknown"
msgid "Unknown request."
msgstr "უცნობი მოთხოვნა."
