msgctxt "Addons::name::quissly_search"
msgid "Quissly search"
msgstr "Quissly search"

msgctxt "Addons::description::quissly_search"
msgid "Replaces native product search with Quissly QSearch. A thin proxy: Quissly returns product IDs, the store's theme renders them, with native-search fallback on failure. Credentials live in config.local.php."
msgstr "ცვლის მაღაზიის ჩაშენებულ პროდუქტების ძიებას Quissly QSearch-ით. Quissly აბრუნებს პროდუქტების ID-ებს, მათ მაღაზიის თემა აჩვენებს; შეცდომისას ჩაშენებული ძიება მუშაობს. მონაცემები ინახება config.local.php-ში ან ერთი ღილაკით დაკავშირებისას."

msgctxt "SettingsSections::quissly_search::general"
msgid "General"
msgstr "ზოგადი"

msgctxt "SettingsOptions::quissly_search::search_interception"
msgid "QSearch: Quissly answers storefront search"
msgstr "QSearch: მაღაზიის ძიებას Quissly პასუხობს"

msgctxt "SettingsTooltips::quissly_search::search_interception"
msgid "When off, the storefront uses native CS-Cart search. Credentials and catalog sync are unaffected."
msgstr "გამორთვისას მაღაზია CS-Cart-ის ჩაშენებულ ძიებას იყენებს. კავშირი და კატალოგის სინქრონიზაცია ამით არ იცვლება."

msgctxt "SettingsOptions::quissly_search::status"
msgid "Status"
msgstr "სტატუსი"

msgctxt "Languages::quissly_search.active"
msgid "Active"
msgstr "აქტიური"

msgctxt "Languages::quissly_search.inactive"
msgid "Inactive"
msgstr "არააქტიური"

msgctxt "Languages::quissly_search.interception_status"
msgid "Search interception"
msgstr "ძიების გადაჭერა"

msgctxt "Languages::quissly_search.inactive_reason"
msgid "Reason"
msgstr "მიზეზი"

msgctxt "Languages::quissly_search.reason_master_toggle_off"
msgid "Master toggle is off"
msgstr "მთავარი ჩამრთველი გამორთულია"

msgctxt "Languages::quissly_search.reason_credentials_not_configured"
msgid "Credentials are not configured in config.local.php"
msgstr "კავშირის მონაცემები config.local.php-ში არ არის მითითებული"

msgctxt "Languages::quissly_search.reason_auth_error"
msgid "Authorization or plan error from Quissly"
msgstr "ავტორიზაციის ან ტარიფის შეცდომა Quissly-სგან"

msgctxt "Languages::quissly_search.credentials"
msgid "Credentials"
msgstr "კავშირის მონაცემები"

msgctxt "Languages::quissly_search.configured"
msgid "Configured"
msgstr "მითითებულია"

msgctxt "Languages::quissly_search.not_configured"
msgid "Not configured in config.local.php"
msgstr "config.local.php-ში მითითებული არ არის"

msgctxt "Languages::quissly_search.environment"
msgid "Environment"
msgstr "გარემო"

msgctxt "Languages::quissly_search.last_auth_error"
msgid "Last authorization error"
msgstr "ავტორიზაციის ბოლო შეცდომა"

msgctxt "Languages::quissly_search.never"
msgid "Never"
msgstr "არასდროს"

msgctxt "Languages::quissly_search.test_connection"
msgid "Test connection"
msgstr "კავშირის შემოწმება"

msgctxt "Languages::quissly_search.test_connection_ok"
msgid "Quissly connection OK ([count] results for a test query)."
msgstr "Quissly-სთან კავშირი წესრიგშია ([count] შედეგი სატესტო ძიებაზე)."

msgctxt "Languages::quissly_search.test_connection_auth_fail"
msgid "Quissly authorization failed (HTTP [status]). Check the bearer token, private key, and environment in config.local.php."
msgstr "Quissly-ში ავტორიზაცია ვერ მოხერხდა (HTTP [status]). შეამოწმეთ bearer ტოკენი, პირადი გასაღები და გარემო config.local.php-ში."

msgctxt "Languages::quissly_search.test_connection_fail"
msgid "Quissly connection failed (HTTP [status])."
msgstr "Quissly-სთან კავშირი ვერ მოხერხდა (HTTP [status])."

msgctxt "Languages::quissly_search.search_temporarily_unavailable"
msgid "Search is temporarily unavailable. Please try again."
msgstr "ძიება დროებით მიუწვდომელია. გთხოვთ, სცადოთ თავიდან."

msgctxt "Languages::sort_by_quissly_relevance_asc"
msgid "Relevance"
msgstr "რელევანტურობა"

msgctxt "Languages::quissly_admin_panel"
msgid "Quissly Admin Panel"
msgstr "Quissly-ს ადმინ პანელი"

msgctxt "Languages::quissly_search.panel_title"
msgid "Quissly panel"
msgstr "Quissly-ს პანელი"

msgctxt "Languages::quissly_search.panel_not_connected"
msgid "This store is not connected to Quissly yet. The panel will load here once it is."
msgstr "ეს მაღაზია Quissly-სთან ჯერ არ არის დაკავშირებული. დაკავშირების შემდეგ პანელი აქ ჩაიტვირთება."

msgctxt "Languages::quissly_search.panel_go_to_settings"
msgid "Connect to Quissly"
msgstr "Quissly-სთან დაკავშირება"

msgctxt "Languages::quissly_search.panel_missing_account"
msgid "The panel can't sign you in automatically: config.local.php has no quissly_project_id or quissly_account_email for this store. Open it in a new tab and sign in with your Quissly account."
msgstr "პანელი ავტომატურად ვერ შეგიყვანთ: config.local.php-ში ამ მაღაზიისთვის quissly_project_id ან quissly_account_email არ არის. გახსენით ახალ ჩანართში და შედით თქვენი Quissly-ს ანგარიშით."

msgctxt "Languages::quissly_search.panel_rejected"
msgid "Quissly refused the sign-in at [host]. Check that this store's account email and project id belong to that Quissly environment - the account Quissly created for this store, not a personal login."
msgstr "Quissly-მ [host]-ზე შესვლა უარყო. შეამოწმეთ, რომ მაღაზიის ანგარიშის ელფოსტა და პროექტის ID ამ Quissly გარემოს ეკუთვნის - ეს უნდა იყოს ანგარიში, რომელიც Quissly-მ ამ მაღაზიისთვის შექმნა, და არა პირადი."

msgctxt "Languages::quissly_search.panel_platform_unsupported"
msgid "Quissly can't sign CS-Cart stores in to the panel automatically yet. Open it in a new tab and sign in with your Quissly account."
msgstr "Quissly ჯერ ვერ ახერხებს CS-Cart მაღაზიების პანელში ავტომატურ შეყვანას. გახსენით ახალ ჩანართში და შედით თქვენი Quissly-ს ანგარიშით."

msgctxt "Languages::quissly_search.panel_unreachable"
msgid "Could not reach Quissly at [host]. Check the connection and try again."
msgstr "[host]-ზე Quissly-სთან დაკავშირება ვერ მოხერხდა. შეამოწმეთ კავშირი და სცადეთ თავიდან."

msgctxt "Languages::quissly_search.panel_unavailable"
msgid "The panel is unavailable right now. Try again in a moment."
msgstr "პანელი ახლა მიუწვდომელია. სცადეთ ცოტა ხანში."

msgctxt "Languages::quissly_search.panel_open_new_tab"
msgid "Open the Quissly panel in a new tab"
msgstr "Quissly-ს პანელის ახალ ჩანართში გახსნა"

msgctxt "Languages::quissly_dashboard"
msgid "Quissly Dashboard"
msgstr "Quissly-ს დაფა"

msgctxt "Languages::quissly_menu_dashboard"
msgid "Dashboard"
msgstr "დაფა"

msgctxt "Languages::quissly_search.setup_title"
msgid "Quissly connection"
msgstr "Quissly-სთან კავშირი"

msgctxt "Languages::quissly_search.reason_initial_sync_pending"
msgid "The first catalog sync hasn't been confirmed by Quissly yet, so the store uses native CS-Cart search until it is."
msgstr "კატალოგის პირველი სინქრონიზაცია Quissly-ს ჯერ არ დაუდასტურებია, ამიტომ მანამდე მაღაზია CS-Cart-ის ჩაშენებულ ძიებას იყენებს."

msgctxt "Languages::quissly_search.yes"
msgid "Yes"
msgstr "დიახ"

msgctxt "Languages::quissly_search.dash_search_status"
msgid "Search status"
msgstr "ძიების სტატუსი"

msgctxt "Languages::quissly_search.dash_search_active"
msgid "Storefront search is answered by Quissly."
msgstr "მაღაზიის ძიებას Quissly პასუხობს."

msgctxt "Languages::quissly_search.dash_search_inactive"
msgid "Storefront search uses native CS-Cart search, because:"
msgstr "მაღაზია CS-Cart-ის ჩაშენებულ ძიებას იყენებს, რადგან:"

msgctxt "Languages::quissly_search.dash_connection"
msgid "Connection"
msgstr "კავშირი"

msgctxt "Languages::quissly_search.dash_not_connected"
msgid "This store is not connected to Quissly yet."
msgstr "ეს მაღაზია Quissly-სთან ჯერ არ არის დაკავშირებული."

msgctxt "Languages::quissly_search.dash_connected"
msgid "Connected"
msgstr "დაკავშირებულია"

msgctxt "Languages::quissly_search.dash_environment"
msgid "Quissly environment"
msgstr "Quissly-ს გარემო"

msgctxt "Languages::quissly_search.dash_catalog_sync"
msgid "Catalog sync"
msgstr "კატალოგის სინქრონიზაცია"

msgctxt "Languages::quissly_search.dash_refused"
msgid "Quissly is refusing catalog updates (HTTP [code]). This usually means there is no active Quissly plan or trial, or the store credentials are no longer accepted. Your products stay queued and nothing is lost: the sync resumes once this is resolved."
msgstr "Quissly კატალოგის განახლებებს არ იღებს (HTTP [code]). როგორც წესი, ეს ნიშნავს, რომ Quissly-ს აქტიური ტარიფი ან საცდელი პერიოდი არ გაქვთ, ან მაღაზიის კავშირის მონაცემები აღარ მიიღება. პროდუქტები რიგში რჩება და არაფერი იკარგება: სინქრონიზაცია პრობლემის მოგვარებისთანავე გაგრძელდება."

msgctxt "Languages::quissly_search.dash_gate_blocked"
msgid "The last full sync finished without Quissly confirming any product, so search stays on native CS-Cart search. Check the sync log for the cause, then sync again."
msgstr "ბოლო სრული სინქრონიზაცია ისე დასრულდა, რომ Quissly-მ არცერთი პროდუქტი არ დაადასტურა, ამიტომ ძიება CS-Cart-ის ჩაშენებულ ძიებაზე რჩება. მიზეზი სინქრონიზაციის ჟურნალში ნახეთ და სინქრონიზაცია თავიდან გაუშვით."

msgctxt "Languages::quissly_search.dash_waiting"
msgid "[count] products from an earlier sync [since] are waiting to be sent again; the next sync run sends them."
msgstr "წინა სინქრონიზაციის [count] პროდუქტი [since] ხელახლა გაგზავნას ელოდება; მათ შემდეგი სინქრონიზაცია გაგზავნის."

msgctxt "Languages::quissly_search.dash_in_quissly"
msgid "Products in Quissly"
msgstr "პროდუქტები Quissly-ში"

msgctxt "Languages::quissly_search.dash_of_active"
msgid "[synced] of [active] active products"
msgstr "[active] აქტიური პროდუქტიდან [synced]"

msgctxt "Languages::quissly_search.dash_queued"
msgid "Changes queued for sync"
msgstr "სინქრონიზაციის რიგში მყოფი ცვლილებები"

msgctxt "Languages::quissly_search.dash_waiting_label"
msgid "Waiting for Quissly to confirm"
msgstr "ელოდება Quissly-ს დადასტურებას"

msgctxt "Languages::quissly_search.dash_last_run"
msgid "Last sync run"
msgstr "ბოლო სინქრონიზაცია"

msgctxt "Languages::quissly_search.dash_last_run_value"
msgid "[ago] ([source]): [confirmed] confirmed, [waiting] waiting, [failed] failed"
msgstr "[ago] ([source]): დადასტურდა [confirmed], ელოდება [waiting], ვერ მოხერხდა [failed]"

msgctxt "Languages::quissly_search.dash_progress"
msgid "Full sync in progress: [done] of [total] products done ([failed] failed)."
msgstr "მიმდინარეობს სრული სინქრონიზაცია: [total]-დან [done] პროდუქტი დამუშავდა ([failed] ვერ მოხერხდა)."

msgctxt "Languages::quissly_search.dash_start_sync"
msgid "Start initial sync"
msgstr "პირველი სინქრონიზაციის დაწყება"

msgctxt "Languages::quissly_search.dash_resync"
msgid "Sync all products again"
msgstr "ყველა პროდუქტის თავიდან სინქრონიზაცია"

msgctxt "Languages::quissly_search.dash_send_queued"
msgid "Send queued changes now"
msgstr "რიგში მყოფი ცვლილებების ახლავე გაგზავნა"

msgctxt "Languages::quissly_search.dash_check_again"
msgid "Check with Quissly again"
msgstr "Quissly-სთან თავიდან შემოწმება"

msgctxt "Languages::quissly_search.dash_auto_sync"
msgid "Automatic sync"
msgstr "ავტომატური სინქრონიზაცია"

msgctxt "Languages::quissly_search.dash_cron_running"
msgid "Running"
msgstr "მუშაობს"

msgctxt "Languages::quissly_search.dash_cron_last"
msgid "last run [ago]"
msgstr "ბოლო გაშვება: [ago]"

msgctxt "Languages::quissly_search.dash_cron_missing"
msgid "Automatic sync is not running. Product changes are queued, but they are only sent when you press a sync button above. To send them automatically, add this line to the server's crontab (every 5 minutes):"
msgstr "ავტომატური სინქრონიზაცია არ მუშაობს. პროდუქტების ცვლილებები რიგში დგება, მაგრამ იგზავნება მხოლოდ მაშინ, როცა ზემოთ სინქრონიზაციის ღილაკს დააჭერთ. ავტომატურად გასაგზავნად სერვერის crontab-ში ეს ხაზი დაამატეთ (ყოველ 5 წუთში):"

msgctxt "Languages::quissly_search.dash_recent_log"
msgid "Sync log"
msgstr "სინქრონიზაციის ჟურნალი"

msgctxt "Languages::quissly_search.dash_open_settings"
msgid "Add-on settings"
msgstr "დამატების პარამეტრები"

msgctxt "Languages::quissly_search.dash_open_panel"
msgid "Open the Quissly Admin Panel"
msgstr "Quissly-ს ადმინ პანელის გახსნა"

msgctxt "Languages::quissly_search.log_empty"
msgid "Nothing has been synced yet."
msgstr "ჯერ არაფერი სინქრონიზებულა."

msgctxt "Languages::quissly_search.ago_seconds"
msgid "[n] s ago"
msgstr "[n] წმ-ის წინ"

msgctxt "Languages::quissly_search.ago_minutes"
msgid "[n] min ago"
msgstr "[n] წთ-ის წინ"

msgctxt "Languages::quissly_search.ago_hours"
msgid "[n] h ago"
msgstr "[n] სთ-ის წინ"

msgctxt "Languages::quissly_search.ago_days"
msgid "[n] days ago"
msgstr "[n] დღის წინ"

msgctxt "Languages::quissly_search.run_summary"
msgid "Quissly sync: [confirmed] products confirmed, [waiting] waiting for Quissly to confirm, [failed] failed, [queued] still queued."
msgstr "Quissly-ს სინქრონიზაცია: დადასტურდა [confirmed] პროდუქტი, Quissly-ს დადასტურებას ელოდება [waiting], ვერ მოხერხდა [failed], რიგში რჩება [queued]."

msgctxt "Languages::quissly_settings"
msgid "Configuration"
msgstr "კონფიგურაცია"

msgctxt "Languages::quissly_search.dash_features"
msgid "Features"
msgstr "ფუნქციები"

msgctxt "Languages::quissly_search.feature_qsearch"
msgid "QSearch (storefront search)"
msgstr "QSearch (მაღაზიის ძიება)"

msgctxt "Languages::quissly_search.feature_on"
msgid "On"
msgstr "ჩართული"

msgctxt "Languages::quissly_search.feature_off"
msgid "Off"
msgstr "გამორთული"

msgctxt "Languages::quissly_search.feature_change"
msgid "Change these in Quissly Settings"
msgstr "ამის შეცვლა Quissly-ს პარამეტრებშია შესაძლებელი"

msgctxt "Languages::quissly_search.setup_intro"
msgid "Connect this store to Quissly in one step. Enter the email for the store's Quissly account and press Connect:"
msgstr "დააკავშირეთ ეს მაღაზია Quissly-სთან ერთი ნაბიჯით. შეიყვანეთ მაღაზიის Quissly-ს ანგარიშის ელფოსტა და დააჭირეთ დაკავშირებას:"

msgctxt "Languages::quissly_search.setup_step_account"
msgid "Quissly creates the account for this store (you will use this email to sign in to the Quissly panel)."
msgstr "Quissly ამ მაღაზიისთვის ანგარიშს ქმნის (ამ ელფოსტით შეხვალთ Quissly-ს პანელში)."

msgctxt "Languages::quissly_search.setup_step_key"
msgid "The add-on generates the store's signing key and registers it with Quissly. The keys are stored encrypted; you never need to copy or paste one."
msgstr "დამატება მაღაზიის ხელმოწერის გასაღებს ქმნის და Quissly-ში არეგისტრირებს. გასაღებები დაშიფრულად ინახება; არაფრის კოპირება ან ჩასმა არ მოგიწევთ."

msgctxt "Languages::quissly_search.setup_step_sync"
msgid "Your active products start syncing to Quissly right away. Storefront search switches to Quissly once Quissly has confirmed them."
msgstr "თქვენი აქტიური პროდუქტები Quissly-ში მაშინვე იწყებს სინქრონიზაციას. მაღაზიის ძიება Quissly-ზე მას შემდეგ გადადის, რაც Quissly მათ დაადასტურებს."

msgctxt "Languages::quissly_search.setup_email"
msgid "Email"
msgstr "ელფოსტა"

msgctxt "Languages::quissly_search.setup_email_hint"
msgid "Use an address that does not already have a Quissly account."
msgstr "გამოიყენეთ მისამართი, რომელსაც Quissly-ს ანგარიში ჯერ არ აქვს."

msgctxt "Languages::quissly_search.setup_connect"
msgid "Connect to Quissly"
msgstr "Quissly-სთან დაკავშირება"

msgctxt "Languages::quissly_search.setup_connect_hint"
msgid "Creating the account can take a minute or two."
msgstr "ანგარიშის შექმნას შეიძლება ერთი-ორი წუთი დასჭირდეს."

msgctxt "Languages::quissly_search.setup_connected"
msgid "This store is connected to Quissly as [email] (environment: [env])."
msgstr "ეს მაღაზია Quissly-სთან დაკავშირებულია როგორც [email] (გარემო: [env])."

msgctxt "Languages::quissly_search.setup_connected_config"
msgid "This store is connected to Quissly with credentials set in config.local.php (environment: [env]). One-click Connect is not needed."
msgstr "ეს მაღაზია Quissly-სთან config.local.php-ში მითითებული მონაცემებით არის დაკავშირებული (გარემო: [env]). ერთი ღილაკით დაკავშირება საჭირო არ არის."

msgctxt "Languages::quissly_search.setup_undecryptable"
msgid "This store was connected to Quissly, but its stored credentials can no longer be read: the crypt_key in config.local.php has changed since. Restore the previous crypt_key. Connecting again would create a second Quissly account, so it is not offered here - contact Quissly support if the old key is lost."
msgstr "ეს მაღაზია Quissly-სთან იყო დაკავშირებული, მაგრამ შენახული მონაცემების წაკითხვა აღარ ხერხდება: config.local.php-ში crypt_key მას შემდეგ შეიცვალა. აღადგინეთ წინა crypt_key. თავიდან დაკავშირება Quissly-ს მეორე ანგარიშს შექმნიდა, ამიტომ აქ არ არის შემოთავაზებული - თუ ძველი გასაღები დაკარგულია, მიმართეთ Quissly-ს მხარდაჭერას."

msgctxt "Languages::quissly_search.connect_email_invalid"
msgid "Enter the email address for this store's Quissly account."
msgstr "შეიყვანეთ ამ მაღაზიის Quissly-ს ანგარიშის ელფოსტა."

msgctxt "Languages::quissly_search.connect_already"
msgid "This store is already connected to Quissly. Connecting again would create a second account and abandon the products already synced to this one."
msgstr "ეს მაღაზია Quissly-სთან უკვე დაკავშირებულია. თავიდან დაკავშირება მეორე ანგარიშს შექმნიდა და ამ ანგარიშში უკვე სინქრონიზებულ პროდუქტებს მიატოვებდა."

msgctxt "Languages::quissly_search.connect_no_domain"
msgid "Could not work out this store's domain."
msgstr "ამ მაღაზიის დომენის დადგენა ვერ მოხერხდა."

msgctxt "Languages::quissly_search.connect_unreachable"
msgid "Could not reach Quissly at [host]. Check the connection and try again."
msgstr "[host]-ზე Quissly-სთან დაკავშირება ვერ მოხერხდა. შეამოწმეთ კავშირი და სცადეთ თავიდან."

msgctxt "Languages::quissly_search.connect_failed"
msgid "Could not connect to Quissly: [detail]"
msgstr "Quissly-სთან დაკავშირება ვერ მოხერხდა: [detail]"

msgctxt "Languages::quissly_search.connect_ok"
msgid "Connected to Quissly."
msgstr "Quissly-სთან დაკავშირებულია."

msgctxt "SettingsOptions::quissly_search::features_header"
msgid "Features"
msgstr "ფუნქციები"

msgctxt "SettingsOptions::quissly_search::enable_overlay"
msgid "Search overlay takes over the theme's search box"
msgstr "საძიებო ფანჯარა თემის საძიებო ველს ანაცვლებს"

msgctxt "SettingsTooltips::quissly_search::enable_overlay"
msgid "Clicking the theme's search box opens Quissly's full-screen search bar over the page. A theme with no search box gets it either way, so the shop can always be searched. Shown only once Quissly search is live."
msgstr "თემის საძიებო ველზე დაჭერა Quissly-ს სრულეკრანიან საძიებო ზოლს ხსნის გვერდის თავზე. თუ თემას საძიებო ველი არ აქვს, ის მაინც ჩნდება, რომ მაღაზიაში ძიება ყოველთვის შესაძლებელი იყოს. ჩანს მხოლოდ მას შემდეგ, რაც Quissly-ს ძიება ჩაირთვება."

msgctxt "SettingsOptions::quissly_search::overlay_mount_selector"
msgid "Search button mount point"
msgstr "საძიებო ღილაკის ადგილი"

msgctxt "SettingsTooltips::quissly_search::overlay_mount_selector"
msgid "Only used when your theme has no search box. A CSS selector for an existing header control - your cart, account or language switcher - and the search button is placed just to its left. Leave empty to auto-detect: the cart, then the account link, then the language switcher, else a floating button at the bottom-left. Example: .ty-cart-content"
msgstr "გამოიყენება მხოლოდ მაშინ, როცა თემას საძიებო ველი არ აქვს. CSS სელექტორი სათაურში არსებული ელემენტისთვის - კალათა, ანგარიში ან ენის გადამრთველი - და საძიებო ღილაკი მის მარცხნივ დაჯდება. ცარიელი დატოვეთ ავტომატური არჩევისთვის: კალათა, შემდეგ ანგარიშის ბმული, შემდეგ ენის გადამრთველი, სხვა შემთხვევაში მცურავი ღილაკი ქვედა მარცხენა კუთხეში. მაგალითი: .ty-cart-content"

msgctxt "SettingsOptions::quissly_search::enable_quick"
msgid "Quick Recommendations"
msgstr "სწრაფი რეკომენდაციები"

msgctxt "SettingsTooltips::quissly_search::enable_quick"
msgid "Product suggestions as the shopper types. Saved now; it takes effect once the feature ships in this add-on."
msgstr "პროდუქტების შემოთავაზებები, სანამ მყიდველი წერს. ინახება ახლავე; ამოქმედდება, როცა ფუნქცია ამ დამატებაში გამოვა."

msgctxt "SettingsOptions::quissly_search::quick_style"
msgid "Quick Recommendations style"
msgstr "სწრაფი რეკომენდაციების სტილი"

msgctxt "SettingsTooltips::quissly_search::quick_style"
msgid "A compact list of names, or larger cards with images and prices. Saved now; it takes effect once Quick Recommendations ships in this add-on."
msgstr "სახელების კომპაქტური სია, ან უფრო დიდი ბარათები სურათებით და ფასებით. ინახება ახლავე; ამოქმედდება, როცა სწრაფი რეკომენდაციები ამ დამატებაში გამოვა."

msgctxt "SettingsVariants::quissly_search::quick_style::rows"
msgid "List - thumbnail, name and price per row"
msgstr "სია - თითო რიგში მინიატურა, სახელი და ფასი"

msgctxt "SettingsVariants::quissly_search::quick_style::carousel"
msgid "Carousel - large cards you can scroll through"
msgstr "კარუსელი - დიდი ბარათები, რომლებსაც გადაფურცლავთ"

msgctxt "SettingsOptions::quissly_search::enable_voice"
msgid "Voice search"
msgstr "ხმოვანი ძიება"

msgctxt "SettingsTooltips::quissly_search::enable_voice"
msgid "A microphone button in the search bar: the shopper speaks for up to 5 seconds and sees matching products. Needs https. Shown only once Quissly search is live."
msgstr "მიკროფონის ღილაკი საძიებო ზოლში: მყიდველი 5 წამამდე საუბრობს და შესაბამის პროდუქტებს ხედავს. საჭიროებს https-ს. ჩანს მხოლოდ მას შემდეგ, რაც Quissly-ს ძიება ჩაირთვება."

msgctxt "SettingsOptions::quissly_search::enable_image"
msgid "Image search"
msgstr "ძიება სურათით"

msgctxt "SettingsTooltips::quissly_search::enable_image"
msgid "A camera button in the search bar (or paste an image): the shopper sends a photo and sees similar products. Shown only once Quissly search is live."
msgstr "კამერის ღილაკი საძიებო ზოლში (ან სურათის ჩასმა): მყიდველი ფოტოს აგზავნის და მსგავს პროდუქტებს ხედავს. ჩანს მხოლოდ მას შემდეგ, რაც Quissly-ს ძიება ჩაირთვება."

msgctxt "SettingsOptions::quissly_search::enable_qchat"
msgid "QChat assistant"
msgstr "QChat ასისტენტი"

msgctxt "SettingsTooltips::quissly_search::enable_qchat"
msgid "Quissly's shopping assistant chat on every storefront page. Uses the chat agent Quissly created for this store's account (checked on the Quissly Dashboard)."
msgstr "Quissly-ს შოპინგ-ასისტენტის ჩატი მაღაზიის ყველა გვერდზე. იყენებს ჩატის აგენტს, რომელიც Quissly-მ ამ მაღაზიის ანგარიშისთვის შექმნა (მოწმდება Quissly-ს დაფაზე)."

msgctxt "Languages::quissly_search.feature_overlay"
msgid "Search overlay"
msgstr "საძიებო ფანჯარა"

msgctxt "Languages::quissly_search.feature_quick"
msgid "Quick Recommendations"
msgstr "სწრაფი რეკომენდაციები"

msgctxt "Languages::quissly_search.feature_voice"
msgid "Voice search"
msgstr "ხმოვანი ძიება"

msgctxt "Languages::quissly_search.feature_image"
msgid "Image search"
msgstr "ძიება სურათით"

msgctxt "Languages::quissly_search.feature_qchat"
msgid "QChat assistant"
msgstr "QChat ასისტენტი"

msgctxt "Languages::quissly_search.feature_not_built"
msgid "not built into the CS-Cart add-on yet: saved, but has no effect until it ships"
msgstr "CS-Cart-ის დამატებაში ჯერ არ არის: ინახება, მაგრამ გამოსვლამდე არაფერს ცვლის"

msgctxt "Languages::quissly_search.feature_waits_for_search"
msgid "appears on the storefront once Quissly search is live"
msgstr "მაღაზიაში გამოჩნდება, როცა Quissly-ს ძიება ჩაირთვება"

msgctxt "Languages::quissly_search.qchat_agent_ok"
msgid "on the storefront, using this account's chat agent"
msgstr "მაღაზიაში ჩანს, ამ ანგარიშის ჩატის აგენტით"

msgctxt "Languages::quissly_search.qchat_agent_missing"
msgid "not shown yet: Quissly has no chat agent for this account ([error]). Check the Quissly Admin Panel."
msgstr "ჯერ არ ჩანს: Quissly-ს ამ ანგარიშისთვის ჩატის აგენტი არ აქვს ([error]). შეამოწმეთ Quissly-ს ადმინ პანელში."

msgctxt "Languages::quissly_search.media_expired"
msgid "This voice or image search has expired. Please search again."
msgstr "ხმოვანი ან სურათით ძიების ვადა ამოიწურა. გთხოვთ, თავიდან მოძებნოთ."

msgctxt "Languages::quissly_search.sf_placeholder"
msgid "Search products…"
msgstr "პროდუქტების ძიება…"

msgctxt "Languages::quissly_search.sf_voice"
msgid "Voice search"
msgstr "ხმოვანი ძიება"

msgctxt "Languages::quissly_search.sf_image"
msgid "Search by image"
msgstr "ძიება სურათით"

msgctxt "Languages::quissly_search.sf_listening"
msgid "Listening…"
msgstr "გისმენთ…"

msgctxt "Languages::quissly_search.sf_searching"
msgid "Searching…"
msgstr "ვეძებთ…"

msgctxt "Languages::quissly_search.sf_mic_unsupported"
msgid "Voice search is not supported in this browser."
msgstr "ამ ბრაუზერში ხმოვანი ძიება არ მუშაობს."

msgctxt "Languages::quissly_search.sf_mic_insecure"
msgid "Voice search needs a secure (https) connection."
msgstr "ხმოვან ძიებას დაცული (https) კავშირი სჭირდება."

msgctxt "Languages::quissly_search.sf_mic_denied"
msgid "Microphone unavailable."
msgstr "მიკროფონი მიუწვდომელია."

msgctxt "Languages::quissly_search.sf_failed"
msgid "Search is unavailable right now. Please try again."
msgstr "ძიება ახლა მიუწვდომელია. გთხოვთ, სცადოთ თავიდან."

msgctxt "Languages::quissly_search.sf_voice_fallback"
msgid "your voice search"
msgstr "თქვენი ხმოვანი ძიება"

msgctxt "Languages::quissly_search.sf_image_fallback"
msgid "your image search"
msgstr "თქვენი ძიება სურათით"

msgctxt "Languages::quissly"
msgid "Quissly"
msgstr "Quissly"

msgctxt "SettingsOptions::quissly_search::catalog_header"
msgid "Catalog data"
msgstr "კატალოგის მონაცემები"

msgctxt "SettingsOptions::quissly_search::catalog_features"
msgid "Product attributes sent to Quissly"
msgstr "Quissly-ში გაგზავნილი პროდუქტის ატრიბუტები"

msgctxt "Languages::quissly_search.catalog_none"
msgid "Your products have no features yet."
msgstr "თქვენს პროდუქტებს მახასიათებლები ჯერ არ აქვთ."

msgctxt "Languages::quissly_search.catalog_hidden"
msgid "hidden on the storefront"
msgstr "მაღაზიაში დამალულია"

msgctxt "Languages::quissly_search.catalog_variation"
msgid "a variation option - always sent on those products"
msgstr "ვარიაციის პარამეტრი - ამ პროდუქტებზე ყოველთვის იგზავნება"

msgctxt "Languages::quissly_search.catalog_help"
msgid "Each ticked feature travels with every product as metadata, which Quissly searches, so \"linen\", \"merino\" or a brand name match even when the description never says so. Pre-ticked: the features your storefront shows (Active, and shown on the product page, the catalog or the product header). Variation options (such as Color and Size in a variation group) always go - they tell the variants apart. Saving a changed list re-sends your whole catalog so existing products pick it up - allow the sync a few minutes on a large store."
msgstr "ყოველი მონიშნული მახასიათებელი ყველა პროდუქტს მეტამონაცემად მიჰყვება, რომელშიც Quissly ეძებს, ასე რომ, \"სელი\", \"მერინოსი\" ან ბრენდის სახელი იპოვება მაშინაც, როცა აღწერაში ეს არ წერია. წინასწარ მონიშნულია ის მახასიათებლები, რომლებსაც თქვენი მაღაზია აჩვენებს (აქტიური, და ჩანს პროდუქტის გვერდზე, კატალოგში ან პროდუქტის სათაურში). ვარიაციის პარამეტრები (მაგალითად, ფერი და ზომა ვარიაციების ჯგუფში) ყოველთვის იგზავნება - ისინი ვარიანტებს ერთმანეთისგან განასხვავებს. შეცვლილი სიის შენახვა მთელ კატალოგს თავიდან აგზავნის, რომ არსებულმა პროდუქტებმაც მიიღონ - დიდ მაღაზიაში სინქრონიზაციას რამდენიმე წუთი დაუთმეთ."

msgctxt "Languages::quissly_search.catalog_resync"
msgid "The features sent to Quissly changed, so your whole catalog is queued to be sent again - see the Quissly Dashboard for progress."
msgstr "Quissly-ში გაგზავნილი მახასიათებლები შეიცვალა, ამიტომ მთელი კატალოგი თავიდან გასაგზავნად დადგა რიგში - პროგრესი Quissly-ს დაფაზე ნახეთ."

msgctxt "Languages::quissly_search.origin_quissly"
msgid "Results by Quissly"
msgstr "შედეგები Quissly-სგან"

msgctxt "Languages::quissly_search.origin_native"
msgid "Results by CS-Cart search"
msgstr "შედეგები CS-Cart-ის ძიებიდან"

msgctxt "Languages::quissly_search.origin_skipped"
msgid "Quissly skipped this search: [reason]"
msgstr "Quissly-მ ეს ძიება გამოტოვა: [reason]"

msgctxt "SettingsOptions::quissly_search::suggestions_header"
msgid "Search bar suggestions"
msgstr "საძიებო ზოლის შემოთავაზებები"

msgctxt "SettingsOptions::quissly_search::search_suggestions"
msgid "Typing suggestions"
msgstr "აკრეფის შემოთავაზებები"

msgctxt "Languages::quissly_search.suggestions_intro"
msgid "Example searches the search overlay types, letter by letter, into its empty search bar, in random order, so shoppers see what they can ask. They stop the moment a shopper starts typing."
msgstr "საძიებო ფანჯარა ძიების მაგალითებს ასო-ასო წერს ცარიელ საძიებო ზოლში, შემთხვევითი თანმიმდევრობით, რომ მყიდველებმა დაინახონ, რისი კითხვა შეუძლიათ. ჩერდება, როგორც კი მყიდველი წერას დაიწყებს."

msgctxt "Languages::quissly_search.suggestions_unavailable"
msgid "Available once the store is connected and its first catalog sync has created search in Quissly - or Quissly could not be reached just now; reload to try again."
msgstr "ხელმისაწვდომი იქნება, როცა მაღაზია დაკავშირდება და კატალოგის პირველი სინქრონიზაცია Quissly-ში ძიებას შექმნის - ან Quissly ახლა მიუწვდომელი იყო; გვერდი განაახლეთ და სცადეთ თავიდან."

msgctxt "Languages::quissly_search.suggestions_enabled"
msgid "Show typing suggestions"
msgstr "აკრეფის შემოთავაზებების ჩვენება"

msgctxt "Languages::quissly_search.suggestions_placeholder"
msgid "e.g. waterproof jacket under $100"
msgstr "მაგ. წყალგაუმტარი ქურთუკი 100$-მდე"

msgctxt "Languages::quissly_search.suggestions_hint"
msgid "One per line, each under [length] characters. With none, the bar keeps its plain placeholder."
msgstr "თითო ხაზზე ერთი, თითოეული [length] სიმბოლოზე ნაკლები. თუ არცერთი არ არის, ზოლში ჩვეულებრივი წარწერა რჩება."

msgctxt "Languages::quissly_search.suggestions_too_many"
msgid "Up to [count] search bar suggestions."
msgstr "საძიებო ზოლის შემოთავაზებები [count]-მდე."

msgctxt "Languages::quissly_search.suggestions_too_long"
msgid "Keep each search bar suggestion under [length] characters."
msgstr "თითოეული საძიებო შემოთავაზება [length] სიმბოლოზე ნაკლები უნდა იყოს."

msgctxt "Languages::quissly_search.suggestions_no_service"
msgid "Search isn't set up for this store in Quissly yet, so there is nowhere to save search bar suggestions."
msgstr "ამ მაღაზიისთვის ძიება Quissly-ში ჯერ არ არის მომზადებული, ამიტომ საძიებო ზოლის შემოთავაზებების შენახვა ჯერ შეუძლებელია."

msgctxt "Languages::quissly_search.suggestions_signin_failed"
msgid "Couldn't sign in to Quissly to save the search bar suggestions. Please try again."
msgstr "საძიებო ზოლის შემოთავაზებების შესანახად Quissly-ში შესვლა ვერ მოხერხდა. გთხოვთ, სცადოთ თავიდან."

msgctxt "Languages::quissly_search.suggestions_save_failed"
msgid "Couldn't save the search bar suggestions. Please try again."
msgstr "საძიებო ზოლის შემოთავაზებების შენახვა ვერ მოხერხდა. გთხოვთ, სცადოთ თავიდან."

msgctxt "Languages::quissly_search.suggestions_use_generated"
msgid "Replace the list with the suggestions generated from your catalog:"
msgstr "სიის ჩანაცვლება თქვენი კატალოგიდან შექმნილი შემოთავაზებებით:"

msgctxt "Languages::quissly_search.suggestions_generated_pending"
msgid "Left empty, suggestions are generated from your catalog after the first catalog sync - each one checked to find products."
msgstr "თუ ცარიელს დატოვებთ, შემოთავაზებები კატალოგის პირველი სინქრონიზაციის შემდეგ თქვენი კატალოგიდან შეიქმნება - თითოეული შემოწმდება, რომ პროდუქტებს პოულობს."

msgctxt "Languages::quissly_search.klaro_cookies_title"
msgid "Quissly search"
msgstr "Quissly search"

msgctxt "Languages::quissly_search.klaro_cookies_description"
msgid "Recognises a returning visitor in search analytics, so searches from the same browser count as one visitor (cookie quissly_uid, 1 year)."
msgstr "ძიების ანალიტიკაში დაბრუნებულ ვიზიტორს ცნობს, ასე რომ, ერთი ბრაუზერიდან გაკეთებული ძიებები ერთ ვიზიტორად ითვლება (ქუქი quissly_uid, 1 წელი)."

msgctxt "Languages::quissly_search.suggestions_count"
msgid "[count] of [max]. 10 is usually more than enough, but you can add up to [max]."
msgstr "[max]-დან [count]. ჩვეულებრივ 10 სავსებით საკმარისია, მაგრამ შეგიძლიათ [max]-მდე დაამატოთ."

msgctxt "Languages::quissly_search.su_title"
msgid "Quissly Setup"
msgstr "Quissly-ს დაყენება"

msgctxt "Languages::quissly_search.su_band_title"
msgid "Let's get Quissly running on your store"
msgstr "მოდით, ჩავრთოთ Quissly თქვენს მაღაზიაში"

msgctxt "Languages::quissly_search.su_band_sub"
msgid "Three short steps. Nothing reaches your storefront until you go live."
msgstr "სამი მოკლე ნაბიჯი. სანამ ჩართვას არ დააჭერთ, მაღაზიაში არაფერი იცვლება."

msgctxt "Languages::quissly_search.su_progress"
msgid "Setup progress"
msgstr "დაყენების პროგრესი"

msgctxt "Languages::quissly_search.su_progress_count"
msgid "[done] of [total]"
msgstr "[total]-დან [done]"

msgctxt "Languages::quissly_search.su_step_details"
msgid "Your details"
msgstr "თქვენი მონაცემები"

msgctxt "Languages::quissly_search.su_step_plan"
msgid "Choose a plan"
msgstr "აირჩიეთ გეგმა"

msgctxt "Languages::quissly_search.su_step_golive"
msgid "Go live"
msgstr "ჩართვა"

msgctxt "Languages::quissly_search.su_step_of"
msgid "Step [n] of [total]"
msgstr "ნაბიჯი [n] / [total]"

msgctxt "Languages::quissly_search.su_details_desc"
msgid "We use this email for your Quissly account and billing notifications."
msgstr "ამ ელფოსტას ვიყენებთ თქვენი Quissly-ს ანგარიშისთვის და გადახდის შეტყობინებებისთვის."

msgctxt "Languages::quissly_search.su_email"
msgid "Email"
msgstr "ელფოსტა"

msgctxt "Languages::quissly_search.su_connected_help"
msgid "Your store is connected to this Quissly account."
msgstr "თქვენი მაღაზია ამ Quissly-ს ანგარიშთან არის დაკავშირებული."

msgctxt "Languages::quissly_search.su_email_help"
msgid "Account and billing emails go here. This can't be changed later."
msgstr "ანგარიშისა და გადახდის წერილები აქ მოვა. მოგვიანებით ვეღარ შეცვლით."

msgctxt "Languages::quissly_search.su_store_name"
msgid "Store name"
msgstr "მაღაზიის სახელი"

msgctxt "Languages::quissly_search.su_store_name_help"
msgid "Letters, numbers, spaces and hyphens. Your Quissly workspace is named after it; left empty, it is named after [domain]."
msgstr "ლათინური ასოები, ციფრები, ჰარები და დეფისები. თქვენი Quissly-ს სამუშაო სივრცე ამ სახელს მიიღებს; ცარიელს თუ დატოვებთ, ეწოდება [domain]."

msgctxt "Languages::quissly_search.su_next"
msgid "What happens next"
msgstr "რა ხდება შემდეგ"

msgctxt "Languages::quissly_search.su_next_plan"
msgid "Pick a plan"
msgstr "აირჩიეთ გეგმა"

msgctxt "Languages::quissly_search.su_next_plan_text"
msgid "Start free, or try a paid plan for 14 days."
msgstr "დაიწყეთ უფასოდ, ან სცადეთ ფასიანი გეგმა 14 დღით."

msgctxt "Languages::quissly_search.su_next_sync"
msgid "Your catalog syncs"
msgstr "კატალოგი სინქრონდება"

msgctxt "Languages::quissly_search.su_next_sync_text"
msgid "Your products are sent to Quissly in the background."
msgstr "თქვენი პროდუქტები Quissly-ში ფონურად იგზავნება."

msgctxt "Languages::quissly_search.su_next_golive_text"
msgid "Switch Quissly search on once your catalog is ready."
msgstr "ჩართეთ Quissly-ს ძიება, როცა კატალოგი მზად იქნება."

msgctxt "Languages::quissly_search.su_side_foot"
msgid "Nothing is charged and nothing is published until you say so."
msgstr "თქვენი თანხმობის გარეშე არაფერი ჩამოიჭრება და არაფერი გამოქვეყნდება."

msgctxt "Languages::quissly_search.su_connected_note"
msgid "Connected to Quissly."
msgstr "Quissly-სთან დაკავშირებულია."

msgctxt "Languages::quissly_search.su_connect_note"
msgid "One click creates your Quissly account and connects this store."
msgstr "ერთი დაჭერით შეიქმნება Quissly-ს ანგარიში და ეს მაღაზია დაუკავშირდება."

msgctxt "Languages::quissly_search.su_continue"
msgid "Continue"
msgstr "გაგრძელება"

msgctxt "Languages::quissly_search.su_connect"
msgid "Connect & continue"
msgstr "დაკავშირება და გაგრძელება"

msgctxt "Languages::quissly_search.su_connecting"
msgid "Creating your Quissly account..."
msgstr "იქმნება თქვენი Quissly-ს ანგარიში..."

msgctxt "Languages::quissly_search.su_saving"
msgid "Saving..."
msgstr "ინახება..."

msgctxt "Languages::quissly_search.su_going_live"
msgid "Going live..."
msgstr "ირთვება..."

msgctxt "Languages::quissly_search.su_pick_plan"
msgid "Pick a plan to continue"
msgstr "გასაგრძელებლად აირჩიეთ გეგმა"

msgctxt "Languages::quissly_search.su_save_year"
msgid "Save %1/yr"
msgstr "დაზოგეთ %1/წელი"

msgctxt "Languages::quissly_search.su_save_pct"
msgid "Save [pct]%"
msgstr "დაზოგეთ [pct]%"

msgctxt "Languages::quissly_search.su_pay_timeout"
msgid "We have not seen the payment yet. Finish it in the other tab, then press \"I have paid\"."
msgstr "გადახდა ჯერ არ ჩანს. დაასრულეთ ის მეორე ჩანართში და დააჭირეთ „გადავიხადე“."

msgctxt "Languages::quissly_search.su_pay_not_yet"
msgid "Payment not received yet."
msgstr "გადახდა ჯერ არ მიღებულა."

msgctxt "Languages::quissly_search.su_error"
msgid "Could not reach the server. Try again in a minute."
msgstr "სერვერთან დაკავშირება ვერ მოხერხდა. სცადეთ ერთ წუთში."

msgctxt "Languages::quissly_search.su_billing"
msgid "Billing"
msgstr "გადახდა"

msgctxt "Languages::quissly_search.su_monthly"
msgid "Monthly"
msgstr "თვიური"

msgctxt "Languages::quissly_search.su_monthly_sub"
msgid "Pay as you go"
msgstr "თვიდან თვემდე"

msgctxt "Languages::quissly_search.su_annual"
msgid "Annual"
msgstr "წლიური"

msgctxt "Languages::quissly_search.su_plans_unavailable"
msgid "Quissly's plans could not be loaded just now. You can carry on and choose a plan later in the Quissly Admin Panel."
msgstr "Quissly-ს გეგმების ჩატვირთვა ახლა ვერ მოხერხდა. შეგიძლიათ გააგრძელოთ და გეგმა მოგვიანებით აირჩიოთ Quissly-ს ადმინ პანელში."

msgctxt "Languages::quissly_search.su_current_plan"
msgid "Your store is on [plan]. You can change plans any time in the Quissly Admin Panel."
msgstr "თქვენი მაღაზია [plan] გეგმაზეა. გეგმის შეცვლა ნებისმიერ დროს შეგიძლიათ Quissly-ს ადმინ პანელში."

msgctxt "Languages::quissly_search.su_billing_closed"
msgid "Paid plans open soon. Start on the free plan now and upgrade any time."
msgstr "ფასიანი გეგმები მალე გაიხსნება. დაიწყეთ უფასო გეგმით და ნებისმიერ დროს გადადით უფრო მაღალზე."

msgctxt "Languages::quissly_search.su_tab_search"
msgid "Search"
msgstr "ძიება"

msgctxt "Languages::quissly_search.su_tab_chat"
msgid "Chat"
msgstr "ჩატი"

msgctxt "Languages::quissly_search.su_plans"
msgid "Plans"
msgstr "გეგმები"

msgctxt "Languages::quissly_search.su_opens_soon"
msgid "Opens soon"
msgstr "მალე"

msgctxt "Languages::quissly_search.su_popular"
msgid "Most popular"
msgstr "ყველაზე პოპულარული"

msgctxt "Languages::quissly_search.su_per_month"
msgid "/mo"
msgstr "/თვე"

msgctxt "Languages::quissly_search.su_pay_waiting"
msgid "Finish the payment in the tab that opened. This page moves on by itself once Quissly has it."
msgstr "დაასრულეთ გადახდა გახსნილ ჩანართში. როცა Quissly მას მიიღებს, ეს გვერდი თავად გადავა შემდეგ ნაბიჯზე."

msgctxt "Languages::quissly_search.su_pay_open"
msgid "Open the payment page again"
msgstr "გადახდის გვერდის ხელახლა გახსნა"

msgctxt "Languages::quissly_search.su_paid"
msgid "I have paid"
msgstr "გადავიხადე"

msgctxt "Languages::quissly_search.su_back"
msgid "Back"
msgstr "უკან"

msgctxt "Languages::quissly_search.su_no_plan"
msgid "Continue without a plan"
msgstr "გაგრძელება გეგმის გარეშე"

msgctxt "Languages::quissly_search.su_golive_desc"
msgid "Your catalog is on its way to Quissly. Once it is ready, Finish Setup switches Quissly search on for your shoppers - or save now and switch it on later."
msgstr "თქვენი კატალოგი Quissly-ში იგზავნება. როცა მზად იქნება, „დაყენების დასრულება“ თქვენი მყიდველებისთვის Quissly-ს ძიებას ჩართავს - ან შეინახეთ ახლა და ჩართეთ მოგვიანებით."

msgctxt "Languages::quissly_search.su_live_search"
msgid "Quissly answers your store's search"
msgstr "თქვენი მაღაზიის ძიებას Quissly უპასუხებს"

msgctxt "Languages::quissly_search.su_live_search_text"
msgid "Your theme still shows the results, as it does today."
msgstr "შედეგებს ისევ თქვენი თემა აჩვენებს, როგორც ახლა."

msgctxt "Languages::quissly_search.su_live_safety"
msgid "Your own search stays as the safety net"
msgstr "თქვენი ძიება სარეზერვოდ რჩება"

msgctxt "Languages::quissly_search.su_live_safety_text"
msgid "If Quissly ever cannot answer, CS-Cart's search does."
msgstr "თუ Quissly ვერ უპასუხებს, CS-Cart-ის ძიება უპასუხებს."

msgctxt "Languages::quissly_search.su_live_config"
msgid "Everything else is in Configuration"
msgstr "დანარჩენი ყველაფერი პარამეტრებშია"

msgctxt "Languages::quissly_search.su_live_config_text"
msgid "Chat, voice and image search, and the search bar."
msgstr "ჩატი, ხმოვანი და სურათით ძიება, საძიებო ველი."

msgctxt "Languages::quissly_search.su_account_setup"
msgid "Quissly account setup"
msgstr "Quissly-ს ანგარიშის მომზადება"

msgctxt "Languages::quissly_search.su_setting_up"
msgid "Setting up..."
msgstr "მზადდება..."

msgctxt "Languages::quissly_search.su_background"
msgid "Running in the background. Finish Setup unlocks when it is done - you can keep working on the left."
msgstr "ფონურად მიმდინარეობს. დასრულება ხელმისაწვდომი გახდება, როცა ეს დამთავრდება - შეგიძლიათ მარცხნივ განაგრძოთ."

msgctxt "Languages::quissly_search.su_waiting"
msgid "Waiting"
msgstr "ელოდება"

msgctxt "Languages::quissly_search.su_done"
msgid "Done"
msgstr "მზადაა"

msgctxt "Languages::quissly_search.su_running"
msgid "Running"
msgstr "მიმდინარეობს"

msgctxt "Languages::quissly_search.su_failed"
msgid "Failed"
msgstr "ვერ შესრულდა"

msgctxt "Languages::quissly_search.su_ready"
msgid "Ready"
msgstr "მზადაა"

msgctxt "Languages::quissly_search.su_needs_attention"
msgid "Needs attention"
msgstr "ყურადღებას საჭიროებს"

msgctxt "Languages::quissly_search.su_retry"
msgid "Start the sync again"
msgstr "სინქრონიზაციის თავიდან დაწყება"

msgctxt "Languages::quissly_search.su_usually"
msgid "Usually a few minutes. This page updates itself - no refresh needed."
msgstr "ჩვეულებრივ რამდენიმე წუთი. გვერდი თავად განახლდება - გადატვირთვა არ არის საჭირო."

msgctxt "Languages::quissly_search.su_golive_note"
msgid "Finish Setup unlocks when background setup completes."
msgstr "დასრულება ხელმისაწვდომი გახდება ფონური მომზადების დასრულების შემდეგ."

msgctxt "Languages::quissly_search.su_tier_free"
msgid "Free"
msgstr "უფასო"

msgctxt "Languages::quissly_search.su_tier_basic"
msgid "Basic"
msgstr "Basic"

msgctxt "Languages::quissly_search.su_tier_starter"
msgid "Starter"
msgstr "Starter"

msgctxt "Languages::quissly_search.su_tier_growth"
msgid "Growth"
msgstr "Growth"

