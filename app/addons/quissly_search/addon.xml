<?xml version="1.0"?>
<addon scheme="3.0">
    <id>quissly_search</id>
    <version>1.0.15</version>
    <!-- design/backend/media/images/addons/quissly_search/icon.png: the add-on page and list show it. -->
    <has_icon>Y</has_icon>
    <priority>2000</priority>
    <position>0</position>
    <status>active</status>
    <default_language>en</default_language>
    <supplier>Quissly</supplier>
    <supplier_link>https://quissly.com</supplier_link>

    <!--
        Settings: the status block, then the storefront feature switches - the same
        six as the WooCommerce plugin and the Magento plugin, with their defaults
        (QSearch and the overlay on, the rest off). lib/Features.php lists them and
        says which are built. Credentials are NOT settings: config.local.php or
        one-click Connect. search_interception keeps its original id.
    -->
    <settings edition_type="ROOT">
        <sections>
            <section id="general">
                <items>
                    <item id="status">
                        <type>info</type>
                        <handler>fn_quissly_search_status_handler</handler>
                    </item>
                    <item id="features_header">
                        <type>header</type>
                    </item>
                    <item id="search_interception">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <item id="enable_overlay">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <!-- The Shopify app's search overlay layout: wide (the default) or center. -->
                    <item id="overlay_layout">
                        <type>selectbox</type>
                        <default_value>wide</default_value>
                        <variants>
                            <item id="wide"></item>
                            <item id="center"></item>
                        </variants>
                    </item>
                    <item id="overlay_mount_selector">
                        <type>input</type>
                        <default_value></default_value>
                    </item>
                    <item id="enable_quick">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <!-- the Magento plugin's quick_style, same values (Features::quickStyle()). -->
                    <item id="quick_style">
                        <type>selectbox</type>
                        <default_value>rows</default_value>
                        <variants>
                            <item id="rows"></item>
                            <item id="carousel"></item>
                        </variants>
                    </item>
                    <item id="enable_voice">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <item id="enable_image">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <item id="enable_qchat">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <!-- Shopping activity for Quissly's analytics (lib/Events/). -->
                    <item id="enable_events">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <!-- Search Examples (the Shopify app's): the typing list, kept in Quissly, drawn
                         by the handler, saved by controllers/backend/addons.pre.php. -->
                    <item id="suggestions_header">
                        <type>header</type>
                    </item>
                    <item id="search_suggestions">
                        <type>info</type>
                        <handler>fn_quissly_search_suggestions_handler</handler>
                    </item>
                    <!-- Search Suggestions (the Shopify app's): the buttons under the empty bar.
                         Which ones (Automatic / Manual) and the Manual lists are kept in Quissly,
                         drawn by the handler, saved by controllers/backend/addons.pre.php. -->
                    <item id="buttons_header">
                        <type>header</type>
                    </item>
                    <item id="overlay_suggestions">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <item id="suggestion_buttons">
                        <type>info</type>
                        <handler>fn_quissly_search_buttons_handler</handler>
                    </item>
                    <!-- "Your recent searches" beside the buttons: the shopper's own, kept in
                         their browser (overlay.js); off, none are shown or kept. -->
                    <item id="overlay_recent">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <!-- Most loved products (the Shopify app's): 8 shown and 4 backups, by
                         product code (lib/MostLoved.php); the handler says what needs fixing. -->
                    <item id="most_loved_header">
                        <type>header</type>
                    </item>
                    <item id="most_loved">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                    <item id="most_loved_shown">
                        <type>textarea</type>
                        <default_value></default_value>
                    </item>
                    <item id="most_loved_backups">
                        <type>textarea</type>
                        <default_value></default_value>
                    </item>
                    <item id="most_loved_status">
                        <type>info</type>
                        <handler>fn_quissly_search_most_loved_handler</handler>
                    </item>
                    <!-- Catalog data (the Magento plugin's): the checklist is drawn by the
                         handler and saved by controllers/backend/addons.pre.php. -->
                    <item id="catalog_header">
                        <type>header</type>
                    </item>
                    <item id="catalog_features">
                        <type>info</type>
                        <handler>fn_quissly_search_catalog_handler</handler>
                    </item>
                    <!-- How often the add-on looks for a new release (lib/Update/Release::FREQUENCIES). -->
                    <item id="updates_header">
                        <type>header</type>
                    </item>
                    <item id="update_check_every">
                        <type>selectbox</type>
                        <default_value>30m</default_value>
                        <variants>
                            <item id="5m"></item>
                            <item id="30m"></item>
                            <item id="1h"></item>
                            <item id="6h"></item>
                            <item id="12h"></item>
                            <item id="1d"></item>
                            <item id="never"></item>
                        </variants>
                    </item>
                </items>
            </section>
        </sections>
    </settings>

    <!-- One-row health record so a storefront 401/402/403 (which happens in the
         shopper's session) can be surfaced to the merchant on the admin page. -->
    <queries>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_health` (
                `lock_id` tinyint(1) unsigned NOT NULL DEFAULT '1',
                `last_status` smallint(5) NOT NULL DEFAULT '0',
                `last_message` varchar(255) NOT NULL DEFAULT '',
                `last_failure_at` int(11) unsigned NOT NULL DEFAULT '0',
                `last_success_at` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`lock_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_queue` (
                `product_id` int(11) unsigned NOT NULL,
                `operation` varchar(10) NOT NULL DEFAULT 'upsert',
                `created_at` int(11) unsigned NOT NULL DEFAULT '0',
                `attempts` smallint(5) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`product_id`),
                KEY `created_at` (`created_at`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_synced` (
                `product_id` int(11) unsigned NOT NULL,
                `synced_at` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`product_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_operations` (
                `operation_id` varchar(64) NOT NULL,
                `kind` varchar(10) NOT NULL,
                `product_ids` mediumtext NOT NULL,
                `sent_at` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`operation_id`),
                KEY `sent_at` (`sent_at`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_state` (
                `name` varchar(64) NOT NULL,
                `value` mediumtext NOT NULL,
                PRIMARY KEY (`name`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_log` (
                `log_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
                `created_at` int(11) unsigned NOT NULL DEFAULT '0',
                `message` varchar(1000) NOT NULL DEFAULT '',
                PRIMARY KEY (`log_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_tokens` (
                `token` char(36) NOT NULL,
                `product_ids` text NOT NULL,
                `created_at` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`token`),
                KEY `created_at` (`created_at`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_rate` (
                `bucket` char(40) NOT NULL,
                `window_start` int(11) unsigned NOT NULL DEFAULT '0',
                `hits` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`bucket`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_ids` (
                `quissly_id` char(36) NOT NULL,
                `product_id` int(11) unsigned NOT NULL,
                PRIMARY KEY (`quissly_id`),
                KEY `product_id` (`product_id`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        </item>
        <!-- has_icon is read into ?:addons at install only: a store updated from an older version
             (the automatic update runs these install queries again) gets the icon this way. -->
        <item for="install">UPDATE ?:addons SET has_icon = 1 WHERE addon = 'quissly_search';</item>
        <!-- Shopping events waiting to be sent (lib/Events/DbEventQueue). -->
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:quissly_search_events` (
                `event_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
                `body` mediumtext NOT NULL,
                `attempts` smallint(5) unsigned NOT NULL DEFAULT '0',
                `created_at` int(11) unsigned NOT NULL DEFAULT '0',
                `next_at` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`event_id`),
                KEY `next_at` (`next_at`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
        </item>
        <item for="uninstall">
            DROP TABLE IF EXISTS `?:quissly_search_health`;
        </item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_events`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_tokens`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_ids`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_rate`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_queue`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_synced`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_operations`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_state`;</item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:quissly_search_log`;</item>
    </queries>
    <functions>
        <!-- The automatic update's work folder (its last backup) goes with the add-on. -->
        <item for="uninstall">fn_quissly_search_uninstall</item>
    </functions>
</addon>
