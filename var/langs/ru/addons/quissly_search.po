msgstr "Голосовой поиск не поддерживается в этом браузере."

msgctxt "Languages::quissly_search.sf_mic_insecure"
msgid "Voice search needs a secure (https) connection."
msgstr "Для голосового поиска нужно защищённое (https) соединение."

msgctxt "Languages::quissly_search.sf_mic_denied"
msgid "Microphone unavailable."
msgstr "Микрофон недоступен."

msgctxt "Languages::quissly_search.sf_failed"
msgid "Search is unavailable right now. Please try again."
msgstr "Поиск сейчас недоступен. Пожалуйста, попробуйте снова."

msgctxt "Languages::quissly_search.sf_voice_fallback"
