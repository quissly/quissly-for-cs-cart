msgstr "Условия использования"

msgctxt "Languages::quissly_search.bi_link_privacy"
msgid "Privacy policy"
msgstr "Политика конфиденциальности"

msgctxt "Languages::quissly_search.bi_claim_label"
msgid "What happened?"
msgstr "Что случилось?"

msgctxt "Languages::quissly_search.bi_claim_title"
msgid "Ask for a refund"
msgstr "Попросить о возврате"

msgctxt "Languages::quissly_search.bi_refund"
msgid "Refund"
msgstr "Вернуть деньги"

msgctxt "Languages::quissly_search.bi_send_request"
msgid "Send request"
msgstr "Отправить запрос"

msgctxt "Languages::quissly_search.bi_claim_length"
msgid "Tell us what happened in 10 to 4000 characters."
msgstr "Опишите, что случилось, от 10 до 4000 символов."

msgctxt "Languages::quissly_search.bi_refund_done_ends"
msgid "Refund requested: [amount] goes back to your card within a few days. The plan has ended."
msgstr "Возврат запрошен: [amount] вернётся на вашу карту в течение нескольких дней. План завершён."

msgctxt "Languages::quissly_search.bi_refund_done_extras"
msgid "Refund requested: [amount] goes back to your card within a few days. The extra requests it paid for were removed."
msgstr "Возврат запрошен: [amount] вернётся на вашу карту в течение нескольких дней. Оплаченные им дополнительные запросы удалены."

msgctxt "Languages::quissly_search.bi_claim_sent"
msgid "Your refund request was sent (ticket [ticket]). A person replies within [days] business days."
msgstr "Ваш запрос на возврат отправлен (обращение [ticket]). Сотрудник ответит в течение [days] рабочих дней."

msgctxt "SettingsOptions::quissly_search::overlay_suggestions"
msgid "Show suggestion buttons"
msgstr "Показывать кнопки подсказок"

msgctxt "SettingsTooltips::quissly_search::overlay_suggestions"
msgid "Buttons under the empty search bar that a shopper can click to search. On by default."
msgstr "Кнопки под пустой строкой поиска: покупатель нажимает и ищет. Включено по умолчанию."

msgctxt "Languages::quissly_search.sf_suggestions"
msgid "[store] suggestions"
msgstr "Подсказки [store]"

msgctxt "Languages::quissly_search.sf_suggestions_plain"
msgid "Suggestions"
msgstr "Подсказки"

msgctxt "Languages::quissly_search.feature_overlay_suggestions"
msgid "Suggestions under the search bar"
msgstr "Подсказки под строкой поиска"

msgctxt "SettingsOptions::quissly_search::enable_events"
msgid "Shopping activity for Quissly analytics"
msgstr "Действия покупателей для аналитики Quissly"

msgctxt "SettingsTooltips::quissly_search::enable_events"
msgid "Sends product page views, searches, adds to cart and to the wishlist, and paid orders to Quissly, for the analytics in the Quissly Admin Panel. Products and order totals only - never a customer's name, email, address or IP. A guest who has not accepted the cookie banner is not tracked. On by default."
msgstr "Отправляет в Quissly просмотры страниц товаров, поиски, добавления в корзину и в избранное и оплаченные заказы - для аналитики в Quissly Admin Panel. Только товары и суммы заказов - никогда имя, email, адрес или IP покупателя. Гость, не принявший cookie-баннер, не учитывается. Включено по умолчанию."

msgctxt "Languages::quissly_search.feature_events"
msgid "Shopping activity"
msgstr "Действия покупателей"

msgctxt "SettingsOptions::quissly_search::buttons_header"
msgid "Search Suggestions"
msgstr "Подсказки поиска"

msgctxt "SettingsOptions::quissly_search::suggestion_buttons"
msgid "Suggestions"
msgstr "Подсказки"

msgctxt "SettingsOptions::quissly_search::most_loved_header"
msgid "Most Loved Products"
msgstr "Самые любимые товары"

msgctxt "SettingsOptions::quissly_search::most_loved"
msgid "Show Most loved products"
msgstr "Показывать самые любимые товары"

msgctxt "SettingsTooltips::quissly_search::most_loved"
msgid "Cards of the products you pick, under the suggestion buttons when search opens. Off by default."
msgstr "Карточки выбранных вами товаров под кнопками подсказок, когда открывается поиск. По умолчанию выключено."

msgctxt "SettingsOptions::quissly_search::most_loved_shown"
msgid "Products to show (8)"
msgstr "Показываемые товары (8)"

msgctxt "SettingsTooltips::quissly_search::most_loved_shown"
msgid "Search by name or code and pick 8, in the order they are shown; drag to change it."
msgstr "Найдите по названию или коду и выберите 8 в порядке показа; перетащите, чтобы изменить порядок."

msgctxt "SettingsOptions::quissly_search::most_loved_backups"
msgid "Backups (4)"
msgstr "Запасные (4)"

msgctxt "SettingsTooltips::quissly_search::most_loved_backups"
msgid "Pick 4, none of them already in Products to show. A product to show that is out of stock is replaced by the first backup in stock."
msgstr "Выберите 4, ни один из них не должен быть среди показываемых. Товар для показа, которого нет в наличии, заменяется первым запасным в наличии."

msgctxt "SettingsOptions::quissly_search::most_loved_status"
msgid "Status"
msgstr "Состояние"

msgctxt "SettingsOptions::quissly_search::updates_header"
msgid "Updates"
msgstr "Обновления"

msgctxt "SettingsOptions::quissly_search::update_check_every"
msgid "Update check frequency"
msgstr "Частота проверки обновлений"

msgctxt "SettingsTooltips::quissly_search::update_check_every"
msgid "How often the add-on looks for a new Quissly version and installs it. Never: no automatic updates."
msgstr "Как часто модуль ищет новую версию Quissly и устанавливает её. Никогда: без автоматических обновлений."

msgctxt "SettingsVariants::quissly_search::update_check_every::5m"
msgid "Every 5 minutes (For testing)"
msgstr "Каждые 5 минут (для тестирования)"

msgctxt "SettingsVariants::quissly_search::update_check_every::30m"
msgid "Every 30 minutes"
msgstr "Каждые 30 минут"

msgctxt "SettingsVariants::quissly_search::update_check_every::1h"
msgid "Every hour"
msgstr "Каждый час"

msgctxt "SettingsVariants::quissly_search::update_check_every::6h"
msgid "Every 6 hours"
msgstr "Каждые 6 часов"

msgctxt "SettingsVariants::quissly_search::update_check_every::12h"
msgid "Every 12 hours"
msgstr "Каждые 12 часов"

msgctxt "SettingsVariants::quissly_search::update_check_every::1d"
msgid "Once a day"
msgstr "Раз в день"

msgctxt "SettingsVariants::quissly_search::update_check_every::never"
msgid "Never"
msgstr "Никогда"

msgctxt "Languages::quissly_search.suggestions_remove"
msgid "Remove"
msgstr "Удалить"

msgctxt "Languages::quissly_search.suggestions_add"
msgid "Add"
msgstr "Добавить"

msgctxt "Languages::quissly_search.suggestions_add_label"
msgid "Add a suggestion"
msgstr "Добавить пример"

msgctxt "Languages::quissly_search.suggestions_reset"
msgid "Reset to generated"
msgstr "Вернуть сгенерированные"

msgctxt "Languages::quissly_search.suggestions_empty_main"
msgid "No suggestions yet. The bar shows its plain placeholder."
msgstr "Пока ничего нет. В строке поиска обычный текст-подсказка."

msgctxt "Languages::quissly_search.suggestions_empty_other"
msgid "No list for this language yet: its shoppers see the default list."
msgstr "Для этого языка списка пока нет: покупатели видят список по умолчанию."

msgctxt "Languages::quissly_search.suggestions_language"
msgid "Language"
msgstr "Язык"

msgctxt "Languages::quissly_search.suggestions_language_note"
msgid "Shoppers see the list for the language they browse your store in. A language with no list of its own uses the default one."
msgstr "Покупатели видят список на языке, на котором смотрят магазин. Язык без своего списка использует список по умолчанию."

msgctxt "Languages::quissly_search.suggestions_language_default"
msgid "[language] (default)"
msgstr "[language] (по умолчанию)"

msgctxt "Languages::quissly_search.buttons_mode"
msgid "Suggestions"
msgstr "Подсказки"

msgctxt "Languages::quissly_search.buttons_mode_automatic"
msgid "Automatic"
msgstr "Автоматически"

msgctxt "Languages::quissly_search.buttons_mode_manual"
msgid "Manual"
msgstr "Вручную"

msgctxt "Languages::quissly_search.buttons_note_automatic"
msgid "Quissly picks them from your catalog, per language."
msgstr "Quissly подбирает их из вашего каталога, для каждого языка."

msgctxt "Languages::quissly_search.buttons_note_manual"
msgid "You type them, per store language."
msgstr "Вы вводите их сами, для каждого языка магазина."

msgctxt "Languages::quissly_search.buttons_shown_now"
msgid "Your shop shows now:"
msgstr "Сейчас магазин показывает:"

msgctxt "Languages::quissly_search.buttons_none_yet"
msgid "None yet - Quissly creates them from your catalog after the first catalog sync."
msgstr "Пока нет - Quissly создаёт их из вашего каталога после первой синхронизации."

msgctxt "Languages::quissly_search.buttons_not_connected"
msgid "Shown here once the store is connected to Quissly and its first catalog sync has finished."
msgstr "Появятся здесь, когда магазин подключится к Quissly и закончится первая синхронизация каталога."

msgctxt "Languages::quissly_search.buttons_field"
msgid "Suggestion [n]"
msgstr "Подсказка [n]"

msgctxt "Languages::quissly_search.buttons_placeholder"
msgid "e.g. black shorts size 32"
msgstr "напр. чёрные шорты размер 32"

msgctxt "Languages::quissly_search.buttons_too_many"
msgid "Up to [max] suggestion buttons per language."
msgstr "Не больше [max] кнопок подсказок на язык."

msgctxt "Languages::quissly_search.most_loved_intro"
msgid "Pick 8 products to show when search opens, and 4 other products as backups: a product that is out of stock is replaced by the first backup in stock. Nothing is shown until 8 + 4 different products are picked and 8 of them can be bought."
msgstr "Выберите 8 товаров, которые видны при открытии поиска, и 4 других товара как запасные: товар, которого нет в наличии, заменяется первым запасным в наличии. Ничего не показывается, пока не выбраны 8 + 4 разных товара и 8 из них нельзя купить."

msgctxt "Languages::quissly_search.most_loved_backup"
msgid "backup"
msgstr "запасной"

msgctxt "Languages::quissly_search.most_loved_reason_not_found"
msgid "no product has this code"
msgstr "товара с таким кодом нет"

msgctxt "Languages::quissly_search.most_loved_reason_not_visible"
msgid "not visible in the store"
msgstr "не виден в магазине"

msgctxt "Languages::quissly_search.most_loved_reason_out_of_stock"
msgid "out of stock"
msgstr "нет в наличии"

msgctxt "Languages::quissly_search.most_loved_ready"
msgid "Ready: shoppers see these products."
msgstr "Готово: покупатели видят эти товары."

msgctxt "Languages::quissly_search.most_loved_missing_shown"
msgid "Products to show still to pick: [count]."
msgstr "Осталось выбрать товаров для показа: [count]."

msgctxt "Languages::quissly_search.most_loved_missing_backups"
msgid "Backups still to pick: [count]."
msgstr "Осталось выбрать запасных: [count]."

