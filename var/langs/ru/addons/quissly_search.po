msgstr "появится в магазине, когда заработает поиск Quissly"

msgctxt "Languages::quissly_search.qchat_agent_ok"
msgid "on the storefront, using this account's chat agent"
msgstr "в магазине, с чат-агентом этого аккаунта"

msgctxt "Languages::quissly_search.qchat_agent_missing"
