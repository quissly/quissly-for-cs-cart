msgctxt "Addons::name::quissly_search"
msgid "Quissly search"
msgstr "Quissly search"

msgctxt "Addons::description::quissly_search"
msgid "Replaces native product search with Quissly QSearch. A thin proxy: Quissly returns product IDs, the store's theme renders them, with native-search fallback on failure. Credentials live in config.local.php."
msgstr "Заменяет встроенный поиск товаров на Quissly QSearch. Quissly возвращает ID товаров, тема магазина их показывает; при сбое работает встроенный поиск. Учётные данные хранятся в config.local.php или задаются подключением в один клик."

msgctxt "SettingsSections::quissly_search::general"
msgid "General"
msgstr "Общие"

msgctxt "SettingsOptions::quissly_search::search_interception"
msgid "QSearch: Quissly answers storefront search"
msgstr "QSearch: поиск в магазине выполняет Quissly"

msgctxt "SettingsTooltips::quissly_search::search_interception"
msgid "When off, the storefront uses native CS-Cart search. Credentials and catalog sync are unaffected."
msgstr "Если выключено, магазин использует встроенный поиск CS-Cart. Подключение и синхронизация каталога не затрагиваются."

msgctxt "SettingsOptions::quissly_search::status"
msgid "Status"
msgstr "Статус"

msgctxt "Languages::quissly_search.active"
msgid "Active"
msgstr "Активно"

msgctxt "Languages::quissly_search.inactive"
msgid "Inactive"
msgstr "Неактивно"

msgctxt "Languages::quissly_search.interception_status"
msgid "Search interception"
msgstr "Перехват поиска"

msgctxt "Languages::quissly_search.inactive_reason"
msgid "Reason"
msgstr "Причина"

msgctxt "Languages::quissly_search.reason_master_toggle_off"
msgid "Master toggle is off"
msgstr "Главный переключатель выключен"

msgctxt "Languages::quissly_search.reason_credentials_not_configured"
msgid "Credentials are not configured in config.local.php"
msgstr "Учётные данные не заданы в config.local.php"

msgctxt "Languages::quissly_search.reason_auth_error"
msgid "Authorization or plan error from Quissly"
msgstr "Ошибка авторизации или тарифа от Quissly"

msgctxt "Languages::quissly_search.credentials"
msgid "Credentials"
msgstr "Учётные данные"

msgctxt "Languages::quissly_search.configured"
msgid "Configured"
msgstr "Заданы"

msgctxt "Languages::quissly_search.not_configured"
msgid "Not configured in config.local.php"
msgstr "Не заданы в config.local.php"

msgctxt "Languages::quissly_search.environment"
msgid "Environment"
msgstr "Окружение"

msgctxt "Languages::quissly_search.last_auth_error"
msgid "Last authorization error"
msgstr "Последняя ошибка авторизации"

msgctxt "Languages::quissly_search.never"
msgid "Never"
msgstr "Никогда"

msgctxt "Languages::quissly_search.test_connection"
msgid "Test connection"
msgstr "Проверить подключение"

msgctxt "Languages::quissly_search.test_connection_ok"
msgid "Quissly connection OK ([count] results for a test query)."
msgstr "Подключение к Quissly в порядке ([count] результатов по тестовому запросу)."

msgctxt "Languages::quissly_search.test_connection_auth_fail"
msgid "Quissly authorization failed (HTTP [status]). Check the bearer token, private key, and environment in config.local.php."
msgstr "Авторизация в Quissly не удалась (HTTP [status]). Проверьте bearer-токен, закрытый ключ и окружение в config.local.php."

msgctxt "Languages::quissly_search.test_connection_fail"
msgid "Quissly connection failed (HTTP [status])."
msgstr "Не удалось подключиться к Quissly (HTTP [status])."

msgctxt "Languages::quissly_search.search_temporarily_unavailable"
msgid "Search is temporarily unavailable. Please try again."
msgstr "Поиск временно недоступен. Пожалуйста, попробуйте снова."

msgctxt "Languages::sort_by_quissly_relevance_asc"
msgid "Relevance"
msgstr "Релевантность"

msgctxt "Languages::quissly_admin_panel"
msgid "Quissly Admin Panel"
msgstr "Панель администратора Quissly"

msgctxt "Languages::quissly_search.panel_title"
msgid "Quissly panel"
msgstr "Панель Quissly"

msgctxt "Languages::quissly_search.panel_not_connected"
msgid "This store is not connected to Quissly yet. The panel will load here once it is."
msgstr "Этот магазин ещё не подключён к Quissly. После подключения панель загрузится здесь."

msgctxt "Languages::quissly_search.panel_go_to_settings"
msgid "Connect to Quissly"
msgstr "Подключиться к Quissly"

msgctxt "Languages::quissly_search.panel_missing_account"
msgid "The panel can't sign you in automatically: config.local.php has no quissly_project_id or quissly_account_email for this store. Open it in a new tab and sign in with your Quissly account."
msgstr "Панель не может выполнить вход автоматически: в config.local.php для этого магазина нет quissly_project_id или quissly_account_email. Откройте её в новой вкладке и войдите в свой аккаунт Quissly."

msgctxt "Languages::quissly_search.panel_rejected"
msgid "Quissly refused the sign-in at [host]. Check that this store's account email and project id belong to that Quissly environment - the account Quissly created for this store, not a personal login."
msgstr "Quissly отклонил вход на [host]. Проверьте, что email аккаунта магазина и ID проекта относятся к этому окружению Quissly - это должен быть аккаунт, который Quissly создал для магазина, а не личный."

msgctxt "Languages::quissly_search.panel_platform_unsupported"
msgid "Quissly can't sign CS-Cart stores in to the panel automatically yet. Open it in a new tab and sign in with your Quissly account."
msgstr "Quissly пока не умеет автоматически входить в панель для магазинов CS-Cart. Откройте её в новой вкладке и войдите в свой аккаунт Quissly."

msgctxt "Languages::quissly_search.panel_unreachable"
msgid "Could not reach Quissly at [host]. Check the connection and try again."
msgstr "Не удалось связаться с Quissly по адресу [host]. Проверьте подключение и попробуйте снова."

msgctxt "Languages::quissly_search.panel_unavailable"
msgid "The panel is unavailable right now. Try again in a moment."
msgstr "Панель сейчас недоступна. Попробуйте чуть позже."

msgctxt "Languages::quissly_search.panel_open_new_tab"
msgid "Open the Quissly panel in a new tab"
msgstr "Открыть панель Quissly в новой вкладке"

msgctxt "Languages::quissly_dashboard"
msgid "Quissly Dashboard"
msgstr "Панель управления Quissly"

msgctxt "Languages::quissly_menu_dashboard"
msgid "Dashboard"
msgstr "Панель управления"

msgctxt "Languages::quissly_search.setup_title"
msgid "Quissly connection"
msgstr "Подключение к Quissly"

msgctxt "Languages::quissly_search.reason_initial_sync_pending"
msgid "The first catalog sync hasn't been confirmed by Quissly yet, so the store uses native CS-Cart search until it is."
msgstr "Quissly ещё не подтвердил первую синхронизацию каталога, поэтому до этого магазин использует встроенный поиск CS-Cart."

msgctxt "Languages::quissly_search.yes"
msgid "Yes"
msgstr "Да"

msgctxt "Languages::quissly_search.dash_search_status"
msgid "Search status"
msgstr "Статус поиска"

msgctxt "Languages::quissly_search.dash_search_active"
msgid "Storefront search is answered by Quissly."
msgstr "Поиск в магазине выполняет Quissly."

msgctxt "Languages::quissly_search.dash_search_inactive"
msgid "Storefront search uses native CS-Cart search, because:"
msgstr "Магазин использует встроенный поиск CS-Cart, потому что:"

msgctxt "Languages::quissly_search.dash_connection"
msgid "Connection"
msgstr "Подключение"

msgctxt "Languages::quissly_search.dash_not_connected"
msgid "This store is not connected to Quissly yet."
msgstr "Этот магазин ещё не подключён к Quissly."

msgctxt "Languages::quissly_search.dash_connected"
msgid "Connected"
msgstr "Подключено"

msgctxt "Languages::quissly_search.dash_environment"
msgid "Quissly environment"
msgstr "Окружение Quissly"

msgctxt "Languages::quissly_search.dash_catalog_sync"
msgid "Catalog sync"
msgstr "Синхронизация каталога"

msgctxt "Languages::quissly_search.dash_refused"
msgid "Quissly is refusing catalog updates (HTTP [code]). This usually means there is no active Quissly plan or trial, or the store credentials are no longer accepted. Your products stay queued and nothing is lost: the sync resumes once this is resolved."
msgstr "Quissly не принимает обновления каталога (HTTP [code]). Обычно это значит, что нет активного тарифа или пробного периода Quissly либо учётные данные магазина больше не принимаются. Товары остаются в очереди, ничего не теряется: синхронизация продолжится, как только это будет решено."

msgctxt "Languages::quissly_search.dash_gate_blocked"
msgid "The last full sync finished without Quissly confirming any product, so search stays on native CS-Cart search. Check the sync log for the cause, then sync again."
msgstr "Последняя полная синхронизация завершилась без подтверждения хотя бы одного товара от Quissly, поэтому поиск остаётся встроенным поиском CS-Cart. Найдите причину в журнале синхронизации и запустите синхронизацию снова."

msgctxt "Languages::quissly_search.dash_waiting"
msgid "[count] products from an earlier sync [since] are waiting to be sent again; the next sync run sends them."
msgstr "[count] товаров из прошлой синхронизации [since] ожидают повторной отправки; их отправит следующий запуск синхронизации."

msgctxt "Languages::quissly_search.dash_in_quissly"
msgid "Products in Quissly"
msgstr "Товары в Quissly"

msgctxt "Languages::quissly_search.dash_of_active"
msgid "[synced] of [active] active products"
msgstr "[synced] из [active] активных товаров"

msgctxt "Languages::quissly_search.dash_queued"
msgid "Changes queued for sync"
msgstr "Изменения в очереди на синхронизацию"

msgctxt "Languages::quissly_search.dash_waiting_label"
msgid "Waiting for Quissly to confirm"
msgstr "Ожидают подтверждения Quissly"

msgctxt "Languages::quissly_search.dash_last_run"
msgid "Last sync run"
msgstr "Последний запуск синхронизации"

msgctxt "Languages::quissly_search.dash_last_run_value"
msgid "[ago] ([source]): [confirmed] confirmed, [waiting] waiting, [failed] failed"
msgstr "[ago] ([source]): подтверждено [confirmed], ожидает [waiting], ошибок [failed]"

msgctxt "Languages::quissly_search.dash_progress"
msgid "Full sync in progress: [done] of [total] products done ([failed] failed)."
msgstr "Идёт полная синхронизация: обработано [done] из [total] товаров (ошибок: [failed])."

msgctxt "Languages::quissly_search.dash_start_sync"
msgid "Start initial sync"
msgstr "Запустить первую синхронизацию"

msgctxt "Languages::quissly_search.dash_resync"
msgid "Sync all products again"
msgstr "Синхронизировать все товары заново"

msgctxt "Languages::quissly_search.dash_send_queued"
msgid "Send queued changes now"
msgstr "Отправить изменения из очереди сейчас"

msgctxt "Languages::quissly_search.dash_check_again"
msgid "Check with Quissly again"
msgstr "Проверить в Quissly ещё раз"

msgctxt "Languages::quissly_search.dash_auto_sync"
msgid "Automatic sync"
msgstr "Автоматическая синхронизация"

msgctxt "Languages::quissly_search.dash_cron_running"
msgid "Running"
msgstr "Работает"

msgctxt "Languages::quissly_search.dash_cron_last"
msgid "last run [ago]"
msgstr "последний запуск [ago]"

msgctxt "Languages::quissly_search.dash_cron_missing"
msgid "Automatic sync is not running. Product changes are queued, but they are only sent when you press a sync button above. To send them automatically, add this line to the server's crontab (every 5 minutes):"
msgstr "Автоматическая синхронизация не работает. Изменения товаров ставятся в очередь, но отправляются, только когда вы нажимаете кнопку синхронизации выше. Чтобы отправлять их автоматически, добавьте эту строку в crontab сервера (каждые 5 минут):"

msgctxt "Languages::quissly_search.dash_recent_log"
msgid "Sync log"
msgstr "Журнал синхронизации"

msgctxt "Languages::quissly_search.dash_open_settings"
msgid "Add-on settings"
msgstr "Настройки модуля"

msgctxt "Languages::quissly_search.dash_open_panel"
msgid "Open the Quissly Admin Panel"
msgstr "Открыть панель администратора Quissly"

msgctxt "Languages::quissly_search.log_empty"
msgid "Nothing has been synced yet."
msgstr "Пока ничего не синхронизировано."

msgctxt "Languages::quissly_search.ago_seconds"
msgid "[n] s ago"
msgstr "[n] с назад"

msgctxt "Languages::quissly_search.ago_minutes"
msgid "[n] min ago"
msgstr "[n] мин назад"

msgctxt "Languages::quissly_search.ago_hours"
msgid "[n] h ago"
msgstr "[n] ч назад"

msgctxt "Languages::quissly_search.ago_days"
msgid "[n] days ago"
msgstr "[n] дн. назад"

msgctxt "Languages::quissly_search.run_summary"
msgid "Quissly sync: [confirmed] products confirmed, [waiting] waiting for Quissly to confirm, [failed] failed, [queued] still queued."
msgstr "Синхронизация Quissly: подтверждено товаров [confirmed], ожидают подтверждения Quissly [waiting], ошибок [failed], ещё в очереди [queued]."

msgctxt "Languages::quissly_settings"
msgid "Configuration"
msgstr "Настройки"

msgctxt "Languages::quissly_search.dash_features"
msgid "Features"
msgstr "Функции"

msgctxt "Languages::quissly_search.feature_qsearch"
msgid "QSearch (storefront search)"
msgstr "QSearch (поиск в магазине)"

msgctxt "Languages::quissly_search.feature_on"
msgid "On"
msgstr "Вкл."

msgctxt "Languages::quissly_search.feature_off"
msgid "Off"
msgstr "Выкл."

msgctxt "Languages::quissly_search.feature_change"
msgid "Change these in Quissly Settings"
msgstr "Изменить это можно в настройках Quissly"

msgctxt "Languages::quissly_search.setup_intro"
msgid "Connect this store to Quissly in one step. Enter the email for the store's Quissly account and press Connect:"
msgstr "Подключите этот магазин к Quissly за один шаг. Введите email для аккаунта Quissly этого магазина и нажмите «Подключить»:"

msgctxt "Languages::quissly_search.setup_step_account"
msgid "Quissly creates the account for this store (you will use this email to sign in to the Quissly panel)."
msgstr "Quissly создаёт аккаунт для этого магазина (с этим email вы будете входить в панель Quissly)."

msgctxt "Languages::quissly_search.setup_step_key"
msgid "The add-on generates the store's signing key and registers it with Quissly. The keys are stored encrypted; you never need to copy or paste one."
msgstr "Модуль создаёт ключ подписи магазина и регистрирует его в Quissly. Ключи хранятся в зашифрованном виде; ничего копировать или вставлять не нужно."

msgctxt "Languages::quissly_search.setup_step_sync"
msgid "Your active products start syncing to Quissly right away. Storefront search switches to Quissly once Quissly has confirmed them."
msgstr "Ваши активные товары сразу начинают синхронизироваться с Quissly. Поиск в магазине переключится на Quissly, как только Quissly их подтвердит."

msgctxt "Languages::quissly_search.setup_email"
msgid "Email"
msgstr "Email"

msgctxt "Languages::quissly_search.setup_email_hint"
msgid "Use an address that does not already have a Quissly account."
msgstr "Используйте адрес, для которого ещё нет аккаунта Quissly."

msgctxt "Languages::quissly_search.setup_connect"
msgid "Connect to Quissly"
msgstr "Подключиться к Quissly"

msgctxt "Languages::quissly_search.setup_connect_hint"
msgid "Creating the account can take a minute or two."
msgstr "Создание аккаунта может занять минуту-другую."

msgctxt "Languages::quissly_search.setup_connected"
msgid "This store is connected to Quissly as [email] (environment: [env])."
msgstr "Этот магазин подключён к Quissly как [email] (окружение: [env])."

msgctxt "Languages::quissly_search.setup_connected_config"
msgid "This store is connected to Quissly with credentials set in config.local.php (environment: [env]). One-click Connect is not needed."
msgstr "Этот магазин подключён к Quissly с учётными данными из config.local.php (окружение: [env]). Подключение в один клик не нужно."

msgctxt "Languages::quissly_search.setup_undecryptable"
msgid "This store was connected to Quissly, but its stored credentials can no longer be read: the crypt_key in config.local.php has changed since. Restore the previous crypt_key. Connecting again would create a second Quissly account, so it is not offered here - contact Quissly support if the old key is lost."
msgstr "Этот магазин был подключён к Quissly, но сохранённые учётные данные больше не читаются: crypt_key в config.local.php с тех пор изменился. Верните прежний crypt_key. Повторное подключение создало бы второй аккаунт Quissly, поэтому здесь оно не предлагается - если старый ключ утерян, обратитесь в поддержку Quissly."

msgctxt "Languages::quissly_search.connect_email_invalid"
msgid "Enter the email address for this store's Quissly account."
msgstr "Введите email для аккаунта Quissly этого магазина."

msgctxt "Languages::quissly_search.connect_already"
msgid "This store is already connected to Quissly. Connecting again would create a second account and abandon the products already synced to this one."
msgstr "Этот магазин уже подключён к Quissly. Повторное подключение создало бы второй аккаунт и бросило бы товары, уже синхронизированные с этим."

msgctxt "Languages::quissly_search.connect_no_domain"
msgid "Could not work out this store's domain."
msgstr "Не удалось определить домен этого магазина."

msgctxt "Languages::quissly_search.connect_unreachable"
msgid "Could not reach Quissly at [host]. Check the connection and try again."
msgstr "Не удалось связаться с Quissly по адресу [host]. Проверьте подключение и попробуйте снова."

msgctxt "Languages::quissly_search.connect_failed"
msgid "Could not connect to Quissly: [detail]"
msgstr "Не удалось подключиться к Quissly: [detail]"

msgctxt "Languages::quissly_search.connect_ok"
msgid "Connected to Quissly."
msgstr "Подключено к Quissly."

msgctxt "SettingsOptions::quissly_search::features_header"
msgid "Features"
msgstr "Функции"

msgctxt "SettingsOptions::quissly_search::enable_overlay"
msgid "Search overlay takes over the theme's search box"
msgstr "Окно поиска заменяет поле поиска темы"

msgctxt "SettingsTooltips::quissly_search::enable_overlay"
msgid "Clicking the theme's search box opens Quissly's full-screen search bar over the page. A theme with no search box gets it either way, so the shop can always be searched. Shown only once Quissly search is live."
msgstr "Нажатие на поле поиска темы открывает полноэкранную строку поиска Quissly поверх страницы. Если в теме нет поля поиска, она появляется в любом случае, чтобы в магазине всегда можно было искать. Показывается только после того, как поиск Quissly заработает."

msgctxt "SettingsOptions::quissly_search::overlay_mount_selector"
msgid "Search button mount point"
msgstr "Место кнопки поиска"

msgctxt "SettingsTooltips::quissly_search::overlay_mount_selector"
msgid "Only used when your theme has no search box. A CSS selector for an existing header control - your cart, account or language switcher - and the search button is placed just to its left. Leave empty to auto-detect: the cart, then the account link, then the language switcher, else a floating button at the bottom-left. Example: .ty-cart-content"
msgstr "Используется, только если в теме нет поля поиска. CSS-селектор существующего элемента в шапке - корзины, аккаунта или переключателя языка - и кнопка поиска встанет слева от него. Оставьте пустым для автоопределения: корзина, затем ссылка на аккаунт, затем переключатель языка, иначе плавающая кнопка внизу слева. Пример: .ty-cart-content"

msgctxt "SettingsOptions::quissly_search::enable_quick"
msgid "Quick Recommendations"
msgstr "Быстрые рекомендации"

msgctxt "SettingsTooltips::quissly_search::enable_quick"
msgid "Product suggestions as the shopper types. Saved now; it takes effect once the feature ships in this add-on."
msgstr "Подсказки товаров, пока покупатель печатает. Сохраняется уже сейчас; заработает, когда функция появится в этом модуле."

msgctxt "SettingsOptions::quissly_search::quick_style"
msgid "Quick Recommendations style"
msgstr "Стиль быстрых рекомендаций"

msgctxt "SettingsTooltips::quissly_search::quick_style"
msgid "A compact list of names, or larger cards with images and prices. Saved now; it takes effect once Quick Recommendations ships in this add-on."
msgstr "Компактный список названий или крупные карточки с изображениями и ценами. Сохраняется уже сейчас; заработает, когда быстрые рекомендации появятся в этом модуле."

msgctxt "SettingsVariants::quissly_search::quick_style::rows"
msgid "List - thumbnail, name and price per row"
msgstr "Список - миниатюра, название и цена в каждой строке"

msgctxt "SettingsVariants::quissly_search::quick_style::carousel"
msgid "Carousel - large cards you can scroll through"
msgstr "Карусель - крупные карточки, которые можно листать"

msgctxt "SettingsOptions::quissly_search::enable_voice"
msgid "Voice search"
msgstr "Голосовой поиск"

msgctxt "SettingsTooltips::quissly_search::enable_voice"
msgid "A microphone button in the search bar: the shopper speaks for up to 5 seconds and sees matching products. Needs https. Shown only once Quissly search is live."
msgstr "Кнопка микрофона в строке поиска: покупатель говорит до 5 секунд и видит подходящие товары. Требуется https. Показывается только после того, как поиск Quissly заработает."

msgctxt "SettingsOptions::quissly_search::enable_image"
msgid "Image search"
msgstr "Поиск по изображению"

msgctxt "SettingsTooltips::quissly_search::enable_image"
msgid "A camera button in the search bar (or paste an image): the shopper sends a photo and sees similar products. Shown only once Quissly search is live."
msgstr "Кнопка камеры в строке поиска (или вставка изображения): покупатель отправляет фото и видит похожие товары. Показывается только после того, как поиск Quissly заработает."

msgctxt "SettingsOptions::quissly_search::enable_qchat"
msgid "QChat assistant"
msgstr "Ассистент QChat"

msgctxt "SettingsTooltips::quissly_search::enable_qchat"
msgid "Quissly's shopping assistant chat on every storefront page. Uses the chat agent Quissly created for this store's account (checked on the Quissly Dashboard)."
msgstr "Чат помощника по покупкам Quissly на каждой странице магазина. Использует чат-агента, которого Quissly создал для аккаунта этого магазина (проверяется на панели управления Quissly)."

