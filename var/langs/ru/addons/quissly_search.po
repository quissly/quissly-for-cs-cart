msgid "Shown, with backups in place of:"
msgstr "Показаны, с запасными вместо:"

msgctxt "Languages::quissly_search.sf_most_loved"
msgid "[store] Most loved"
msgstr "[store]: самые любимые"

msgctxt "Languages::quissly_search.sf_most_loved_plain"
msgid "Most loved"
msgstr "Самые любимые"

msgctxt "Languages::quissly_search.sf_rating"
msgid "%s out of 5"
msgstr "%s из 5"

msgctxt "Languages::quissly_search.sf_variants"
msgid "[count] [option] available"
msgstr "Вариантов: [count]"

msgctxt "Languages::quissly_search.sf_variants_plain"
msgid "[count] options available"
msgstr "Вариантов: [count]"

msgctxt "Languages::quissly_search.most_loved_duplicates"
msgid "These products are in both Products to show and Backups. Keep each in one list only:"
msgstr "Эти товары есть и среди показываемых, и среди запасных. Оставьте каждый только в одном списке:"

msgctxt "Languages::quissly_search.su_details_title"
msgid "Tell us about your store"
msgstr "Расскажите о своём магазине"

msgctxt "Languages::quissly_search.su_email_updates"
msgid "Email for account updates"
msgstr "Email для уведомлений об аккаунте"

msgctxt "Languages::quissly_search.su_store_name_placeholder"
msgid "Acme Outdoors"
msgstr "Acme Outdoors"

msgctxt "Languages::quissly_search.su_what_you_sell"
msgid "What do you sell?"
msgstr "Что вы продаёте?"

msgctxt "Languages::quissly_search.su_what_you_sell_placeholder"
msgid "e.g. Outdoor gear and camping equipment"
msgstr "напр. снаряжение для походов и кемпинга"

msgctxt "Languages::quissly_search.su_drafted_help"
msgid "Drafted from your store's products. Edit anything that isn't right."
msgstr "Составлено по товарам вашего магазина. Исправьте, если что-то не так."

msgctxt "Languages::quissly_search.su_sell_help"
msgid "One or two sentences about what you sell and who it's for."
msgstr "Одно-два предложения о том, что вы продаёте и для кого."

msgctxt "Languages::quissly_search.su_save_continue"
msgid "Save & continue"
msgstr "Сохранить и продолжить"

msgctxt "Languages::quissly_search.su_nothing_charged"
msgid "Nothing is charged yet."
msgstr "Пока ничего не списывается."

msgctxt "Languages::quissly_search.su_block_email_missing"
msgid "Add an email to continue."
msgstr "Укажите email, чтобы продолжить."

msgctxt "Languages::quissly_search.su_block_email_invalid"
msgid "Fix the email to continue."
msgstr "Исправьте email, чтобы продолжить."

msgctxt "Languages::quissly_search.su_block_name_missing"
msgid "Add your store name to continue."
msgstr "Укажите название магазина, чтобы продолжить."

msgctxt "Languages::quissly_search.su_block_name_invalid"
msgid "Fix the store name to continue."
msgstr "Исправьте название магазина, чтобы продолжить."

msgctxt "Languages::quissly_search.su_block_sell_missing"
msgid "Add what you sell to continue."
msgstr "Укажите, что вы продаёте, чтобы продолжить."

msgctxt "Languages::quissly_search.su_required_both"
msgid "Store name and what you sell are both required."
msgstr "Нужно указать и название магазина, и что вы продаёте."

msgctxt "Languages::quissly_search.su_name_chars"
msgid "Store name can only contain letters, numbers, spaces and hyphens."
msgstr "Название магазина может содержать только буквы, цифры, пробелы и дефисы."

msgctxt "Languages::quissly_search.su_description_long"
msgid "Description must be 500 characters or fewer."
msgstr "Описание должно быть не длиннее 500 символов."

msgctxt "Languages::quissly_search.su_journey_details"
msgid "Tell us about your store"
msgstr "Расскажите о магазине"

msgctxt "Languages::quissly_search.su_journey_details_text"
msgid "You're here. It takes a minute."
msgstr "Вы здесь. Это займёт минуту."

msgctxt "Languages::quissly_search.su_journey_plan"
msgid "Pick a plan"
msgstr "Выберите план"

msgctxt "Languages::quissly_search.su_journey_plan_text"
msgid "Start free, or pick a paid plan and pay on a secure checkout page."
msgstr "Начните бесплатно или выберите платный план и оплатите на защищённой странице оплаты."

msgctxt "Languages::quissly_search.su_journey_live"
msgid "Turn Quissly on"
msgstr "Включите Quissly"

msgctxt "Languages::quissly_search.su_journey_live_text"
msgid "We set everything up and import your products. Then you switch Quissly on."
msgstr "Мы всё настроим и импортируем ваши товары. Затем вы включаете Quissly."

msgctxt "Languages::quissly_search.su_plan_desc"
msgid "Change or cancel anytime in Billing."
msgstr "Меняйте или отменяйте в любое время в разделе Billing."

msgctxt "Languages::quissly_search.su_want"
msgid "What do you want on your store?"
msgstr "Что вы хотите в своём магазине?"

msgctxt "Languages::quissly_search.su_tab_search_sub"
msgid "A smarter search bar"
msgstr "Более умная строка поиска"

msgctxt "Languages::quissly_search.su_tab_chat_sub"
msgid "An AI shopping assistant"
msgstr "AI-помощник для покупок"

msgctxt "Languages::quissly_search.su_not_sure"
msgid "Not sure? Growth is our most popular plan, and you can change anytime."
msgstr "Не уверены? Growth - наш самый популярный план, и его можно сменить в любое время."

msgctxt "Languages::quissly_search.su_plan_locked"
msgid "Your plan is already active. You can change it in Billing once setup is finished."
msgstr "Ваш план уже активен. Сменить его можно в разделе Billing после завершения настройки."

msgctxt "Languages::quissly_search.su_intro_building"
msgid "We're setting up your account - usually about a minute. Then your products are sent to Quissly."
msgstr "Мы настраиваем ваш аккаунт - обычно около минуты. Затем ваши товары отправятся в Quissly."

msgctxt "Languages::quissly_search.su_intro_importing"
msgid "Your products are on their way to Quissly. Finish Setup unlocks once they're in."
msgstr "Ваши товары отправляются в Quissly. Finish Setup станет доступна, когда они будут там."

msgctxt "Languages::quissly_search.su_intro_failed"
msgid "One thing left: your products didn't reach Quissly. Start the import again under Account setup, or do this later."
msgstr "Осталось одно: ваши товары не дошли до Quissly. Запустите импорт снова в разделе настройки аккаунта или сделайте это позже."

msgctxt "Languages::quissly_search.su_intro_ready"
msgid "Everything is ready. Finish setup to switch Quissly on and open your dashboard."
msgstr "Всё готово. Завершите настройку, чтобы включить Quissly и открыть панель."

msgctxt "Languages::quissly_search.su_body_building"
msgid "We do this part for you - nothing to click. This page updates by itself."
msgstr "Эту часть мы делаем за вас - ничего нажимать не нужно. Страница обновляется сама."

msgctxt "Languages::quissly_search.su_body_built"
msgid "All done. Here's what we set up for your store."
msgstr "Готово. Вот что мы настроили для вашего магазина."

msgctxt "Languages::quissly_search.su_note_building"
msgid "Finish unlocks when account setup completes."
msgstr "Finish станет доступна после настройки аккаунта."

msgctxt "Languages::quissly_search.su_note_waiting"
msgid "Not ready yet? Do this later and turn Quissly on from Configuration."
msgstr "Ещё не готовы? Сделайте это позже и включите Quissly в настройках."

msgctxt "Languages::quissly_search.su_note_ready"
msgid "All set - finish setup to open your dashboard."
msgstr "Всё готово - завершите настройку, чтобы открыть панель."

msgctxt "Languages::quissly_search.su_do_later"
msgid "Do this later"
msgstr "Сделать позже"

msgctxt "Languages::quissly_search.su_technical"
msgid "Technical details"
msgstr "Технические подробности"

msgctxt "Languages::quissly_search.su_pending"
msgid "Pending"
msgstr "Ожидает"

msgctxt "Languages::quissly_search.su_row_account"
msgid "Quissly Account"
msgstr "Аккаунт Quissly"

msgctxt "Languages::quissly_search.su_up_next"
msgid "Up next"
msgstr "Далее"

msgctxt "Languages::quissly_search.su_creating_account"
msgid "Creating your account"
msgstr "Создаём ваш аккаунт"

msgctxt "Languages::quissly_search.su_setting_up_search"
msgid "Setting up search"
msgstr "Настраиваем поиск"

msgctxt "Languages::quissly_search.su_setting_up_assistant"
msgid "Setting up the assistant"
msgstr "Настраиваем помощника"

msgctxt "Languages::quissly_search.su_chat_later"
msgid "Not ready yet - you can switch chat on later in Configuration."
msgstr "Ещё не готово - чат можно включить позже в настройках."

msgctxt "Languages::quissly_search.su_import_failed"
msgid "Catalog import failed. Start it again below, or finish setup and retry from the Dashboard."
msgstr "Импорт каталога не удался. Запустите его снова ниже или завершите настройку и повторите с панели."

msgctxt "Languages::quissly_search.su_reading_products"
msgid "Reading your products..."
msgstr "Читаем ваши товары..."

msgctxt "Languages::quissly_search.su_importing_products"
msgid "Importing your products - [sent] of [total]"
msgstr "Импортируем товары - [sent] из [total]"

msgctxt "Languages::quissly_search.su_starting_shortly"
msgid "Starting shortly"
msgstr "Скоро начнётся"

msgctxt "Languages::quissly_search.su_starts_when_ready"
msgid "Starts once your account is ready"
msgstr "Начнётся, когда аккаунт будет готов"

msgctxt "Languages::quissly_search.su_live_chat"
msgid "Your AI shopping assistant joins your store"
msgstr "AI-помощник появляется в вашем магазине"

msgctxt "Languages::quissly_search.su_live_chat_text"
msgid "It finds your products through Quissly search."
msgstr "Он находит ваши товары через поиск Quissly."

msgctxt "Languages::quissly_search.su_live_chat_now"
msgid "Your AI shopping assistant is live on your store."
msgstr "AI-помощник уже работает в вашем магазине."

msgctxt "Languages::quissly_search.su_payment"
msgid "Payment"
msgstr "Оплата"

msgctxt "Languages::quissly_search.su_pay_invoice"
msgid "Manual invoice"
msgstr "По счёту"

msgctxt "Languages::quissly_search.su_pay_card"
msgid "Credit card"
msgstr "Банковской картой"

msgctxt "Languages::quissly_search.su_invoice_note"
msgid "paid by invoice, no card needed now"
msgstr "оплата по счёту, карта сейчас не нужна"

msgctxt "Languages::quissly_search.most_loved_search"
msgid "Search products by name or code"
