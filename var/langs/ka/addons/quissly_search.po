msgstr "მოგვწერეთ, რა მოხდა, 10-დან 4000 სიმბოლომდე."

msgctxt "Languages::quissly_search.bi_refund_done_ends"
msgid "Refund requested: [amount] goes back to your card within a few days. The plan has ended."
msgstr "დაბრუნება მოთხოვნილია: [amount] რამდენიმე დღეში დაბრუნდება თქვენს ბარათზე. პლანი დასრულდა."

msgctxt "Languages::quissly_search.bi_refund_done_extras"
msgid "Refund requested: [amount] goes back to your card within a few days. The extra requests it paid for were removed."
msgstr "დაბრუნება მოთხოვნილია: [amount] რამდენიმე დღეში დაბრუნდება თქვენს ბარათზე. ამ თანხით ნაყიდი დამატებითი მოთხოვნები მოიხსნა."

msgctxt "Languages::quissly_search.bi_claim_sent"
msgid "Your refund request was sent (ticket [ticket]). A person replies within [days] business days."
msgstr "თქვენი მოთხოვნა გაიგზავნა (ბილეთი [ticket]). თანამშრომელი [days] სამუშაო დღეში გიპასუხებთ."

msgctxt "SettingsOptions::quissly_search::overlay_suggestions"
msgid "Show suggestion buttons"
msgstr "შეთავაზების ღილაკების ჩვენება"

msgctxt "SettingsTooltips::quissly_search::overlay_suggestions"
msgid "Buttons under the empty search bar that a shopper can click to search. On by default."
msgstr "ღილაკები ცარიელი საძიებო ველის ქვეშ - მყიდველი დააჭერს და ეძებს. ნაგულისხმევად ჩართულია."

msgctxt "Languages::quissly_search.sf_suggestions"
msgid "[store] suggestions"
msgstr "[store] - შეთავაზებები"

msgctxt "Languages::quissly_search.sf_suggestions_plain"
msgid "Suggestions"
msgstr "შეთავაზებები"

msgctxt "Languages::quissly_search.feature_overlay_suggestions"
msgid "Suggestions under the search bar"
msgstr "შეთავაზებები ძიების ველის ქვეშ"

msgctxt "Languages::quissly_search.feature_overlay_recent"
msgid "Recent searches under the search bar"
msgstr "ბოლო ძიებები ძიების ველის ქვეშ"

msgctxt "SettingsOptions::quissly_search::overlay_recent"
msgid "Show recent searches"
msgstr "ბოლო ძიებების ჩვენება"

msgctxt "SettingsTooltips::quissly_search::overlay_recent"
msgid "The shopper's last 5 searches under the empty search bar, kept only in their own browser and never sent anywhere. Off: none are shown or kept. On by default."
msgstr "მყიდველის ბოლო 5 ძიება ცარიელი საძიებო ველის ქვეშ - ინახება მხოლოდ მის ბრაუზერში და არსად იგზავნება. გამორთულზე არც ჩანს და არც ინახება. ნაგულისხმევად ჩართულია."

msgctxt "SettingsOptions::quissly_search::enable_events"
msgid "Shopping activity for Quissly analytics"
msgstr "მყიდველის მოქმედებები Quissly-ის ანალიტიკისთვის"

msgctxt "SettingsTooltips::quissly_search::enable_events"
msgid "Sends product page views, searches, adds to cart and to the wishlist, and paid orders to Quissly, for the analytics in the Quissly Admin Panel. Products and order totals only - never a customer's name, email, address or IP. A guest who has not accepted the cookie banner is not tracked. On by default."
msgstr "Quissly-ს უგზავნის პროდუქტის გვერდის ნახვებს, ძიებებს, კალათაში და სურვილების სიაში დამატებებს და გადახდილ შეკვეთებს, Quissly Admin Panel-ის ანალიტიკისთვის. მხოლოდ პროდუქტები და შეკვეთის ჯამი - არასდროს მყიდველის სახელი, ელფოსტა, მისამართი ან IP. სტუმარი, რომელსაც cookie-ბანერზე თანხმობა არ მიუცია, არ აღირიცხება. ნაგულისხმევად ჩართულია."

msgctxt "Languages::quissly_search.feature_events"
msgid "Shopping activity"
msgstr "მყიდველის მოქმედებები"

msgctxt "SettingsOptions::quissly_search::buttons_header"
msgid "Search Suggestions"
msgstr "ძიების შეთავაზებები"

msgctxt "SettingsOptions::quissly_search::suggestion_buttons"
msgid "Suggestions"
msgstr "შეთავაზებები"

msgctxt "SettingsOptions::quissly_search::most_loved_header"
msgid "Most Loved Products"
msgstr "ყველაზე მოწონებული პროდუქტები"

msgctxt "SettingsOptions::quissly_search::most_loved"
msgid "Show Most loved products"
msgstr "ყველაზე მოწონებული პროდუქტების ჩვენება"

msgctxt "SettingsTooltips::quissly_search::most_loved"
msgid "Cards of the products you pick, under the suggestion buttons when search opens. Off by default."
msgstr "თქვენ მიერ არჩეული პროდუქტების ბარათები შეთავაზების ღილაკების ქვეშ, როცა ძიება იხსნება. ნაგულისხმევად გამორთულია."

msgctxt "SettingsOptions::quissly_search::most_loved_shown"
msgid "Products to show (8)"
msgstr "საჩვენებელი პროდუქტები (8)"

msgctxt "SettingsTooltips::quissly_search::most_loved_shown"
msgid "Search by name or code and pick 8, in the order they are shown; drag to change it."
msgstr "მოძებნეთ სახელით ან კოდით და აირჩიეთ 8, ჩვენების თანმიმდევრობით; რიგის შესაცვლელად გადაათრიეთ."

msgctxt "SettingsOptions::quissly_search::most_loved_backups"
msgid "Backups (4)"
msgstr "სარეზერვო (4)"

msgctxt "SettingsTooltips::quissly_search::most_loved_backups"
msgid "Pick 4, none of them already in Products to show. A product to show that is out of stock is replaced by the first backup in stock."
msgstr "აირჩიეთ 4; არცერთი არ უნდა იყოს საჩვენებელ პროდუქტებში. საჩვენებელ პროდუქტს, რომელიც მარაგში არ არის, მარაგში არსებული პირველი სარეზერვო ცვლის."

msgctxt "SettingsOptions::quissly_search::most_loved_status"
