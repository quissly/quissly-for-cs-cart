msgstr "ყველაფერი მზადაა. აი, რა მოვამზადეთ თქვენი მაღაზიისთვის."

msgctxt "Languages::quissly_search.su_note_building"
msgid "Finish unlocks when account setup completes."
msgstr "Finish ანგარიშის მომზადების დასრულების შემდეგ გააქტიურდება."

msgctxt "Languages::quissly_search.su_note_waiting"
msgid "Not ready yet? Do this later and turn Quissly on from Configuration."
msgstr "ჯერ მზად არ ხართ? გააკეთეთ მოგვიანებით და ჩართეთ Quissly Configuration-იდან."

msgctxt "Languages::quissly_search.su_note_ready"
msgid "All set - finish setup to open your dashboard."
msgstr "ყველაფერი მზადაა - დაასრულეთ დაყენება და გაიხსნება dashboard."

