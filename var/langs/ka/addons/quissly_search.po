msgstr "რაღაც შეცდომა მოხდა"

msgctxt "Languages::quissly_search.bi_cancel_plan"
msgid "Cancel plan"
msgstr "გეგმის გაუქმება"

msgctxt "Languages::quissly_search.bi_buy_now"
msgid "Buy now"
msgstr "ყიდვა"

msgctxt "Languages::quissly_search.bi_preview_upgrade"
msgid "[amount] is charged to your saved card now (the rest of this period), and the new plan starts at once."
msgstr "[amount] ახლავე ჩამოიჭრება შენახული ბარათიდან (ამ პერიოდის დარჩენილი ნაწილისთვის) და ახალი გეგმა მაშინვე დაიწყება."

msgctxt "Languages::quissly_search.bi_preview_downgrade"
msgid "Nothing is charged or refunded. Your plan changes on [date]."
msgstr "არაფერი ჩამოიჭრება და არც დაბრუნდება. გეგმა შეიცვლება [date]-ს."

msgctxt "Languages::quissly_search.bi_preview_trial"
msgid "Free during your trial. The plan changes now."
msgstr "საცდელ პერიოდში უფასოა. გეგმა ახლავე შეიცვლება."

msgctxt "Languages::quissly_search.bi_preview_other"
msgid "Your plan changes."
msgstr "თქვენი გეგმა შეიცვლება."

msgctxt "Languages::quissly_search.bi_preview_topup"
msgid "[count] extra requests for [amount], charged to your saved card now. They carry over to next month while the plan continues."
msgstr "[count] დამატებითი მოთხოვნა [amount]-ად, ახლავე ჩამოიჭრება შენახული ბარათიდან. სანამ გეგმა მოქმედებს, ისინი შემდეგ თვეზე გადადის."

msgctxt "Languages::quissly_search.bi_free_on"
msgid "The free plan is on."
msgstr "უფასო გეგმა ჩართულია."

msgctxt "Languages::quissly_search.bi_paid_on"
msgid "Payment received - your plan is on."
msgstr "გადახდა მიღებულია - გეგმა ჩართულია."

msgctxt "Languages::quissly_search.bi_done_scheduled"
msgid "Your plan changes on [date]."
msgstr "თქვენი გეგმა შეიცვლება [date]-ს."

msgctxt "Languages::quissly_search.bi_done_processing"
msgid "Payment is being confirmed; your new plan starts as soon as it lands."
msgstr "გადახდა დასტურდება; ახალი გეგმა დადასტურებისთანავე დაიწყება."

msgctxt "Languages::quissly_search.bi_done_changed"
msgid "Your plan has changed."
msgstr "თქვენი გეგმა შეიცვალა."

msgctxt "Languages::quissly_search.bi_topup_processing"
msgid "Payment is being confirmed; the extra requests are added as soon as it lands."
msgstr "გადახდა დასტურდება; დამატებითი მოთხოვნები დადასტურებისთანავე დაემატება."

msgctxt "Languages::quissly_search.bi_topup_added"
msgid "[count] extra requests added."
msgstr "დაემატა [count] დამატებითი მოთხოვნა."

msgctxt "Languages::quissly_search.bi_done_cancel"
msgid "Your plan is cancelled and ends at the end of the paid period."
msgstr "გეგმა გაუქმდა და გადახდილი პერიოდის ბოლოს დასრულდება."

msgctxt "Languages::quissly_search.bi_done_resume"
msgid "Your plan continues."
msgstr "თქვენი გეგმა გრძელდება."

msgctxt "Languages::quissly_search.bi_done_abort"
msgid "The scheduled change is undone."
msgstr "დაგეგმილი ცვლილება გაუქმდა."

msgctxt "Languages::quissly_search.bi_unknown"
msgid "Unknown request."
msgstr "უცნობი მოთხოვნა."

msgctxt "Languages::quissly_search.bi_at_hint"
msgid "One block of [count] requests ([price]) at a time, up to this much a month."
msgstr "ერთჯერზე ერთი ბლოკი, [count] მოთხოვნა ([price]), თვეში მაქსიმუმ ამ თანხამდე."

msgctxt "Languages::quissly_search.bi_rate_search"
msgid "[price] per search"
msgstr "[price] ერთ ძიებაზე"

msgctxt "Languages::quissly_search.bi_rate_chat"
msgid "[price] per AI message"
msgstr "[price] ერთ AI შეტყობინებაზე"

msgctxt "Languages::quissly_search.bi_refund_back"
msgid "[amount] goes back to your card."
msgstr "[amount] თქვენს ბარათზე დაბრუნდება."

msgctxt "Languages::quissly_search.bi_refund_claim_offer"
msgid "You can still ask for a refund: tell us what happened, and a person replies within 3 business days."
msgstr "თანხის დაბრუნება მაინც შეგიძლიათ მოითხოვოთ: მოგვწერეთ, რა მოხდა, და თანამშრომელი 3 სამუშაო დღეში გიპასუხებთ."

msgctxt "Languages::quissly_search.bi_refund_none"
msgid "This plan cannot be refunded."
msgstr "ამ პლანის თანხა არ ბრუნდება."

msgctxt "Languages::quissly_search.bi_at_meta"
msgid "auto top-up up to [price] a month"
msgstr "ავტო-შევსება თვეში [price]-მდე"

msgctxt "Languages::quissly_search.bi_at_on"
msgid "Automatic top-up: up to [price] a month."
msgstr "ავტომატური შევსება: თვეში [price]-მდე."

msgctxt "Languages::quissly_search.bi_at_off"
msgid "Automatic top-up is off."
msgstr "ავტომატური შევსება გამორთულია."

msgctxt "Languages::quissly_search.bi_request_refund"
msgid "Request a refund"
msgstr "თანხის დაბრუნების მოთხოვნა"

msgctxt "Languages::quissly_search.bi_at_on_plan"
msgid "Automatic top-up on this plan"
msgstr "ავტომატური შევსება ამ პლანზე"

msgctxt "Languages::quissly_search.bi_at_toggle"
msgid "Top up automatically"
msgstr "ავტომატურად შევსება"

msgctxt "Languages::quissly_search.bi_at_max"
msgid "Max per month"
msgstr "მაქსიმუმი თვეში"

msgctxt "Languages::quissly_search.bi_at_explain"
msgid "When this month's requests are about to run out, Quissly buys one more block on your card. Off, requests stop at your plan's limit until next month."
msgstr "როცა ამ თვის მოთხოვნები ილევა, Quissly თქვენს ბარათზე კიდევ ერთ ბლოკს ყიდულობს. გამორთულ მდგომარეობაში მოთხოვნები პლანის ლიმიტზე ჩერდება შემდეგ თვემდე."

msgctxt "Languages::quissly_search.bi_at_title_for"
msgid "[product]: automatic top-up"
msgstr "[product]: ავტომატური შევსება"

msgctxt "Languages::quissly_search.bi_at_title"
msgid "Automatic top-up"
msgstr "ავტომატური შევსება"

msgctxt "Languages::quissly_search.bi_at_save"
msgid "Save automatic top-up"
msgstr "ავტომატური შევსების შენახვა"

msgctxt "Languages::quissly_search.bi_at_range"
msgid "Enter a monthly maximum from %1 to %2."
msgstr "მიუთითეთ თვიური მაქსიმუმი %1-დან %2-მდე."

msgctxt "Languages::quissly_search.bi_at_saved_on"
msgid "Automatic top-up is on: up to [price] a month."
msgstr "ავტომატური შევსება ჩართულია: თვეში [price]-მდე."

msgctxt "Languages::quissly_search.bi_at_saved_off"
msgid "Automatic top-up is off."
msgstr "ავტომატური შევსება გამორთულია."

msgctxt "Languages::quissly_search.bi_link_refund"
msgid "Refund policy"
msgstr "თანხის დაბრუნების წესები"

msgctxt "Languages::quissly_search.bi_link_terms"
msgid "Terms of service"
msgstr "მომსახურების პირობები"

msgctxt "Languages::quissly_search.bi_link_privacy"
msgid "Privacy policy"
msgstr "კონფიდენციალურობის პოლიტიკა"

msgctxt "Languages::quissly_search.bi_claim_label"
msgid "What happened?"
msgstr "რა მოხდა?"

msgctxt "Languages::quissly_search.bi_claim_title"
msgid "Ask for a refund"
msgstr "თანხის დაბრუნების თხოვნა"

msgctxt "Languages::quissly_search.bi_refund"
msgid "Refund"
msgstr "დაბრუნება"

msgctxt "Languages::quissly_search.bi_send_request"
