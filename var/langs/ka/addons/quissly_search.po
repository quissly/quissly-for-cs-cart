msgstr "განახლების შემოწმების სიხშირე"

msgctxt "SettingsTooltips::quissly_search::update_check_every"
msgid "How often the add-on looks for a new Quissly version and installs it. Never: no automatic updates."
msgstr "რამდენად ხშირად ეძებს დამატება Quissly-ის ახალ ვერსიას და აყენებს მას. არასდროს: ავტომატური განახლებების გარეშე."

msgctxt "SettingsVariants::quissly_search::update_check_every::5m"
msgid "Every 5 minutes (For testing)"
msgstr "ყოველ 5 წუთში (ტესტირებისთვის)"

msgctxt "SettingsVariants::quissly_search::update_check_every::30m"
msgid "Every 30 minutes"
msgstr "ყოველ 30 წუთში"

msgctxt "SettingsVariants::quissly_search::update_check_every::1h"
msgid "Every hour"
msgstr "ყოველ საათში"

msgctxt "SettingsVariants::quissly_search::update_check_every::6h"
